<% content_for :page_title, "Supplier" %>
<% content_for :page_subtitle, "Data pemasok dan distributor" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center">
        <svg class="w-6 h-6 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
        </svg>
      </div>
      <div>
        <p class="text-2xl font-bold text-slate-900"><%= @suppliers.total_count %></p>
        <p class="text-sm text-slate-500">Total supplier</p>
      </div>
    </div>
    <%= render "shared/export_buttons" %>
  </div>

  <% if @suppliers.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Supplier</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Kontak</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Telepon</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Alamat</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase">Produk</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @suppliers.each do |supplier| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4 font-semibold text-slate-900"><%= supplier.name %></td>
                <td class="px-6 py-4 text-slate-600"><%= supplier.contact_person.presence || "—" %></td>
                <td class="px-6 py-4 text-slate-600"><%= supplier.phone.presence || "—" %></td>
                <td class="px-6 py-4 text-slate-500 max-w-xs truncate"><%= supplier.address.presence || "—" %></td>
                <td class="px-6 py-4 text-right font-semibold text-slate-900"><%= supplier.products.size %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @suppliers %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-20 px-6">
      <div class="text-4xl mb-3">🚚</div>
      <p class="text-slate-500 text-sm">Belum ada data supplier.</p>
    </div>
  <% end %>
</div>
