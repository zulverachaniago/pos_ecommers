<% content_for :page_title, "Report Penjualan" %>
<% content_for :page_subtitle, "Laporan penjualan POS dan pesanan online" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
    <div>
      <p class="text-2xl font-bold text-slate-900">Rp <%= number_with_delimiter(@total_sales.to_i) %></p>
      <p class="text-sm text-slate-500">
        <%= @transaction_count %> transaksi · <%= @start_date.strftime("%d/%m/%Y") %> – <%= @end_date.strftime("%d/%m/%Y") %>
      </p>
      <p class="text-xs text-slate-400 mt-1">
        POS Rp <%= number_with_delimiter(@pos_sales.to_i) %> (<%= @pos_count %>) ·
        Online Rp <%= number_with_delimiter(@online_sales.to_i) %> (<%= @online_count %>)
      </p>
    </div>
    <%= render "shared/export_buttons" %>
  </div>

  <%= form_with url: owner_reports_sales_path, method: :get, class: "bg-white rounded-2xl border border-slate-100 shadow-sm p-4 flex flex-col sm:flex-row sm:items-end gap-4" do %>
    <div class="flex-1">
      <%= label_tag :start_date, "Dari Tanggal", class: "block text-xs font-medium text-slate-700 mb-1.5" %>
      <%= date_field_tag :start_date, @start_date, class: "w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm" %>
    </div>
    <div class="flex-1">
      <%= label_tag :end_date, "Sampai Tanggal", class: "block text-xs font-medium text-slate-700 mb-1.5" %>
      <%= date_field_tag :end_date, @end_date, class: "w-full px-3 py-2.5 border border-slate-200 rounded-xl text-sm" %>
    </div>
    <%= submit_tag "Filter", class: "px-6 py-2.5 bg-violet-600 hover:bg-violet-700 text-white font-semibold rounded-xl text-sm transition cursor-pointer" %>
  <% end %>

  <% if @sales_entries.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Sumber</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">No. Referensi</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Tanggal</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Pelanggan</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">PIC</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Bayar</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @sales_entries.each do |entry| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4">
                  <span class="inline-flex px-2.5 py-1 text-xs font-semibold rounded-full <%= entry.source == 'Online' ? 'bg-sky-100 text-sky-700' : 'bg-emerald-100 text-emerald-700' %>">
                    <%= entry.source %>
                  </span>
                </td>
                <td class="px-6 py-4 font-mono text-xs font-semibold text-slate-900"><%= entry.number %></td>
                <td class="px-6 py-4 text-slate-500 text-xs"><%= entry.occurred_at.strftime("%d/%m/%Y %H:%M") %></td>
                <td class="px-6 py-4 text-slate-600"><%= entry.customer_name %></td>
                <td class="px-6 py-4 text-slate-500 text-xs"><%= entry.staff %></td>
                <td class="px-6 py-4">
                  <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full"><%= entry.payment_method %></span>
                </td>
                <td class="px-6 py-4 text-slate-500 text-xs"><%= entry.status %></td>
                <td class="px-6 py-4 text-right font-semibold text-emerald-600">Rp <%= number_with_delimiter(entry.total_amount.to_i) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @sales_entries %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-16 px-6">
      <div class="text-4xl mb-3">📊</div>
      <p class="text-slate-500 text-sm">Tidak ada penjualan pada periode ini.</p>
    </div>
  <% end %>
</div>
