<% content_for :title, @product.name %>

<% category_gradients = [
  "from-sky-100 to-blue-200",
  "from-emerald-100 to-teal-200",
  "from-amber-100 to-orange-200",
  "from-violet-100 to-purple-200",
  "from-rose-100 to-pink-200",
  "from-cyan-100 to-sky-200"
] %>
<% gradient = category_gradients[@product.category_id.to_i % category_gradients.size] %>
<% variants = @product.product_variants.to_a %>
<% min_price = variants.map(&:price_grosir).compact.min %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 lg:py-10">
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6 flex-wrap">
    <%= link_to store_products_path, class: "inline-flex items-center gap-1.5 hover:text-sky-600 transition" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Katalog
    <% end %>
    <span class="text-gray-300">/</span>
    <% if @product.category %>
      <%= link_to @product.category.name,
                  store_products_path(category_id: @product.category_id),
                  class: "hover:text-sky-600 transition" %>
      <span class="text-gray-300">/</span>
    <% end %>
    <span class="text-gray-900 font-medium truncate max-w-xs"><%= @product.name %></span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
    <div class="space-y-4">
      <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden relative">
        <% if @product.image.attached? %>
          <%= link_to url_for(@product.image),
                      target: "_blank",
                      rel: "noopener",
                      class: "block",
                      title: "Lihat gambar produk" do %>
            <div class="aspect-square bg-gray-100 relative">
              <%= image_tag @product.image,
                            class: "w-full h-full object-cover hover:opacity-95 transition",
                            alt: @product.name %>
              <% if @product.is_active %>
                <% product_stock = product_stock_summary(@product, @stock_totals) %>
                <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/90 backdrop-blur-sm text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm <%= product_stock[:status] == :out ? 'text-red-700' : 'text-emerald-700' %>">
                  <span class="w-2 h-2 rounded-full <%= product_stock[:status] == :out ? 'bg-red-500' : 'bg-emerald-500' %>"></span>
                  <%= product_stock[:status] == :out ? "Stok Habis" : "Stok #{product_stock[:label]}" %>
                </span>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="aspect-square bg-gradient-to-br <%= gradient %> flex items-center justify-center relative">
            <span class="text-7xl lg:text-8xl">🛍️</span>
            <% if @product.is_active %>
              <% product_stock = product_stock_summary(@product, @stock_totals) %>
              <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 bg-white/90 backdrop-blur-sm text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm <%= product_stock[:status] == :out ? 'text-red-700' : 'text-emerald-700' %>">
                <span class="w-2 h-2 rounded-full <%= product_stock[:status] == :out ? 'bg-red-500' : 'bg-emerald-500' %>"></span>
                <%= product_stock[:status] == :out ? "Stok Habis" : "Stok #{product_stock[:label]}" %>
              </span>
            <% end %>
          </div>
        <% end %>
        <div class="absolute top-4 right-4 z-10">
          <%= render "store/shared/wishlist_button", product: @product %>
        </div>
      </div>
    </div>

    <div>
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <% if @product.category %>
          <%= link_to store_products_path(category_id: @product.category_id),
                      class: "inline-flex px-3 py-1 bg-sky-100 text-sky-700 text-sm font-semibold rounded-full hover:bg-sky-200 transition" do %>
            <%= @product.category.name %>
          <% end %>
        <% end %>
        <% if @product.sku.present? %>
          <span class="text-xs text-gray-400 bg-gray-100 px-3 py-1 rounded-full">SKU: <%= @product.sku %></span>
        <% end %>
      </div>

      <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 leading-tight tracking-tight mb-4">
        <%= @product.name %>
      </h1>

      <% if min_price %>
        <div class="mb-6 pb-6 border-b border-gray-100">
          <p class="text-sm text-gray-500 mb-1">Harga grosir mulai dari</p>
          <p class="text-3xl font-bold text-emerald-600">
            Rp <%= number_with_delimiter(min_price.to_i) %>
          </p>
        </div>
      <% end %>

      <% if @product.description.present? %>
        <p class="text-gray-600 leading-relaxed mb-6"><%= @product.description %></p>
      <% end %>

      <div>
        <h2 class="font-semibold text-gray-900 mb-4">Pilih Varian & Tambah ke Keranjang</h2>

        <% if variants.any? %>
          <div class="space-y-3">
            <% variants.each do |variant| %>
              <% snapshot = variant_stock_snapshot(variant, @stock_totals) %>
              <div class="bg-white border border-gray-200 rounded-2xl p-4 hover:border-sky-300 hover:shadow-md transition <%= snapshot[:status] == :out ? 'opacity-75' : '' %>">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-lg flex-shrink-0">📦</div>
                    <div>
                      <p class="font-semibold text-gray-900"><%= variant.variant_name %></p>
                      <% if variant.unit.present? %>
                        <p class="text-sm text-gray-500">Satuan: <%= variant.unit %></p>
                      <% end %>
                      <div class="mt-1 flex items-center gap-2">
                        <p class="text-xs text-gray-500">
                          Stok: <span class="font-semibold text-gray-800"><%= stock_quantity_label(snapshot[:on_hand], variant.unit) %></span>
                        </p>
                        <%= render "shared/stock_status_badge", status: snapshot[:status], compact: true %>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-3 sm:flex-shrink-0">
                    <div class="text-right">
                      <p class="text-lg font-bold text-emerald-600">
                        Rp <%= number_with_delimiter(variant.price_grosir.to_i) %>
                      </p>
                      <p class="text-xs text-gray-400">grosir</p>
                    </div>
                    <% if snapshot[:on_hand].positive? %>
                      <% if store_customer_signed_in? %>
                        <%= button_to "+ Keranjang",
                                      add_item_store_cart_path,
                                      method: :post,
                                      params: { product_variant_id: variant.id, quantity: 1 },
                                      class: "px-4 py-2.5 bg-sky-600 hover:bg-sky-700 text-white text-sm font-semibold rounded-xl transition border-0 cursor-pointer whitespace-nowrap" %>
                      <% else %>
                        <%= link_to "+ Keranjang", new_user_session_path,
                                    class: "px-4 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl transition whitespace-nowrap" %>
                      <% end %>
                    <% else %>
                      <span class="px-4 py-2.5 bg-gray-100 text-gray-400 text-sm font-semibold rounded-xl whitespace-nowrap">
                        Stok Habis
                      </span>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 text-center text-gray-500 text-sm">
            Belum ada varian harga untuk produk ini.
          </div>
        <% end %>
      </div>

      <% if store_customer_signed_in? && store_cart_items_count.positive? %>
        <%= link_to store_cart_path,
                    class: "mt-6 inline-flex items-center gap-2 px-5 py-3 bg-white border border-sky-200 text-sky-700 font-semibold rounded-2xl hover:bg-sky-50 transition text-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
          </svg>
          Lihat Keranjang (<%= store_cart_items_count %>)
        <% end %>
      <% end %>
    </div>
  </div>
</div>
