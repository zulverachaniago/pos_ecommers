<% content_for :title, "Wishlist" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 lg:py-10">
  <div class="mb-8">
    <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight">Wishlist</h1>
    <p class="text-gray-500 mt-1"><%= @wishlist_items.size %> produk favorit tersimpan.</p>
  </div>

  <% if @wishlist_items.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 lg:gap-6">
      <% @wishlist_items.each do |wishlist_item| %>
        <% product = wishlist_item.product %>
        <% variants = product.product_variants.to_a %>
        <% min_price = variants.map(&:price_grosir).compact.min %>

        <article class="bg-white rounded-3xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-lg transition flex flex-col">
          <div class="relative">
            <%= link_to store_product_path(product), class: "block" do %>
              <div class="h-36 bg-gradient-to-br from-rose-50 to-pink-100 flex items-center justify-center">
                <span class="text-4xl">🛍️</span>
              </div>
            <% end %>
            <div class="absolute top-3 right-3 z-10">
              <%= button_to store_wishlist_path(wishlist_item),
                            method: :delete,
                            form: { class: "product-wishlist-form" },
                            class: "product-wishlist-btn is-active",
                            title: "Hapus dari wishlist" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              <% end %>
            </div>
          </div>

          <div class="p-4 flex flex-col flex-1">
            <h3 class="font-semibold text-gray-900 leading-snug mb-2 line-clamp-2">
              <%= link_to product.name, store_product_path(product), class: "hover:text-sky-600 transition" %>
            </h3>

            <% if min_price %>
              <p class="text-lg font-bold text-emerald-600 mb-4">
                Rp <%= number_with_delimiter(min_price.to_i) %>
                <span class="text-xs font-normal text-gray-400">/ grosir</span>
              </p>
            <% end %>

            <div class="flex gap-2 mt-auto">
              <%= link_to "Detail", store_product_path(product),
                          class: "flex-1 py-2.5 text-center border border-gray-200 text-gray-700 rounded-2xl text-sm font-medium hover:bg-gray-50 transition" %>
              <%= render "store/shared/add_to_cart_button", product: product, variants: variants %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-12 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-rose-50 rounded-3xl text-4xl mb-5">❤️</div>
      <h2 class="text-xl font-bold text-gray-900 mb-2">Wishlist masih kosong</h2>
      <p class="text-gray-500 mb-6">Ketuk ikon love di katalog untuk menyimpan produk favorit.</p>
      <%= link_to "Jelajahi Katalog", store_products_path,
                  class: "inline-block px-8 py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition" %>
    </div>
  <% end %>
</div>
