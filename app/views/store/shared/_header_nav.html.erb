<% beranda_active = controller_name == "products" && action_name == "index" %>
<% wishlist_active = controller_name == "wishlists" %>
<% cart_active = controller_name == "carts" %>
<% orders_active = controller_name == "orders" %>
<% profile_active = controller_name == "customers" %>
<% cart_count = store_customer_signed_in? ? store_cart_items_count : 0 %>
<% wishlist_count = store_customer_signed_in? ? store_wishlist_count : 0 %>
<% customer_signed_in = store_customer_signed_in? %>

<div class="flex items-center gap-0.5 sm:gap-1">
  <%= link_to store_products_path,
              class: "store-nav-item #{beranda_active ? 'is-active' : ''}",
              title: "Beranda" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
    </svg>
    <span class="store-nav-item__label">Beranda</span>
  <% end %>

  <% if customer_signed_in %>
    <%= link_to store_wishlists_path,
                class: "store-nav-item #{wishlist_active ? 'is-active' : ''}",
                title: "Wishlist" do %>
      <span class="relative inline-flex">
        <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
        <% if wishlist_count.positive? %>
          <span class="store-nav-item__badge store-nav-item__badge--rose"><%= wishlist_count > 99 ? "99+" : wishlist_count %></span>
        <% end %>
      </span>
      <span class="store-nav-item__label">Wishlist</span>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path,
                class: "store-nav-item",
                title: "Wishlist" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
      </svg>
      <span class="store-nav-item__label">Wishlist</span>
    <% end %>
  <% end %>

  <%= link_to (customer_signed_in ? store_cart_path : new_user_session_path),
              class: "store-nav-item store-nav-item--cart #{cart_active ? 'is-active' : ''}",
              title: "Keranjang" do %>
    <span class="relative inline-flex">
      <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
      </svg>
      <% if cart_count.positive? %>
        <span class="store-nav-item__badge"><%= cart_count > 99 ? "99+" : cart_count %></span>
      <% end %>
    </span>
    <span class="store-nav-item__label">Keranjang</span>
  <% end %>

  <%= link_to (customer_signed_in ? store_orders_path : new_user_session_path),
              class: "store-nav-item #{orders_active ? 'is-active' : ''}",
              title: "Pesanan" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
    </svg>
    <span class="store-nav-item__label">Pesanan</span>
  <% end %>

  <div class="relative" data-controller="dropdown">
    <button type="button"
            data-action="click->dropdown#toggle"
            class="store-nav-item <%= profile_active ? 'is-active' : '' %>"
            title="Pengaturan"
            aria-haspopup="true"
            aria-expanded="false">
      <svg xmlns="http://www.w3.org/2000/svg" class="store-nav-item__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span class="store-nav-item__label">Setting</span>
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 mt-2 w-52 bg-white rounded-2xl border border-gray-100 shadow-xl shadow-gray-200/60 py-2 z-50">
      <% if customer_signed_in %>
        <%= link_to edit_store_customer_path,
                    class: "store-dropdown-link #{profile_active && !request.url.include?('#address') ? 'is-active' : ''}",
                    data: { action: "click->dropdown#hide" } do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          Profile
        <% end %>
        <%= link_to edit_store_customer_path(anchor: "address"),
                    class: "store-dropdown-link",
                    data: { action: "click->dropdown#hide" } do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          Alamat
        <% end %>
        <div class="my-1 border-t border-gray-100"></div>
        <%= link_to destroy_user_session_path,
                    data: { turbo_method: :delete, action: "click->dropdown#hide" },
                    class: "store-dropdown-link store-dropdown-link--danger" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
          </svg>
          Keluar
        <% end %>
      <% else %>
        <%= link_to new_user_session_path,
                    class: "store-dropdown-link",
                    data: { action: "click->dropdown#hide" } do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m-3 0l-3-3m0 0l3 3m-3-3H9" />
          </svg>
          Masuk
        <% end %>
        <%= link_to new_user_registration_path,
                    class: "store-dropdown-link",
                    data: { action: "click->dropdown#hide" } do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
          </svg>
          Daftar
        <% end %>
      <% end %>
    </div>
  </div>
</div>
