<%# locals: (product:) %>
<% active = product_wishlisted?(product) %>

<% if store_customer_signed_in? %>
  <%= button_to toggle_store_wishlists_path,
                method: :post,
                params: { product_id: product.id },
                form: { class: "product-wishlist-form" },
                class: "product-wishlist-btn #{active ? 'is-active' : ''}",
                title: active ? "Hapus dari wishlist" : "Simpan ke wishlist" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="<%= active ? 'currentColor' : 'none' %>">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
  <% end %>
<% else %>
  <%= link_to new_user_session_path,
              class: "product-wishlist-btn",
              title: "Login untuk wishlist" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" fill="none">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
    </svg>
  <% end %>
<% end %>
