<% content_for :title, "Profil Warung" %>

<div class="max-w-xl mx-auto px-4 sm:px-6 py-8 lg:py-10">
  <div class="mb-8">
    <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight">Profil Warung</h1>
    <% if @return_to_cart %>
      <div class="mt-4 flex gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl text-sm text-amber-900">
        <span class="text-lg leading-none">⚠️</span>
        <p>Isi <strong>alamat pengiriman</strong> di bawah, lalu simpan untuk melanjutkan pesanan dari keranjang.</p>
      </div>
    <% else %>
      <p class="text-gray-500 mt-2">Lengkapi data warung Anda untuk pengiriman order.</p>
    <% end %>
  </div>

  <div class="bg-white shadow-sm border border-gray-100 rounded-3xl p-6 lg:p-8">
    <%= form_with(model: @customer, url: store_customer_path(return_to: params[:return_to]), method: :patch, class: "space-y-5") do |f| %>
      <% if @customer.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl text-sm">
          <p class="font-semibold mb-2"><%= pluralize(@customer.errors.count, "kesalahan") %> perlu diperbaiki:</p>
          <ul class="list-disc list-inside space-y-1">
            <% @customer.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Nama Warung / Pelanggan", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :name,
                         class: "w-full px-4 py-3 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-gray-50 focus:bg-white transition",
                         placeholder: "Contoh: Warung Bu Siti" %>
      </div>

      <div>
        <%= f.label :customer_type, "Tipe Pelanggan", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.select :customer_type,
                     [["Business / Grosir", "business"], ["Retail / Ecer", "retail"]],
                     {},
                     class: "w-full px-4 py-3 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-gray-50 focus:bg-white transition",
                     data: { tom_select_search: "false" } %>
      </div>

      <div>
        <%= f.label :phone, "Telepon / WhatsApp", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :phone,
                         class: "w-full px-4 py-3 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-gray-50 focus:bg-white transition",
                         placeholder: "0812-3456-7890" %>
      </div>

      <div id="address" class="<%= 'address-field-highlight' if @return_to_cart %>">
        <%= f.label :address, "Alamat Pengiriman", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :address,
                        rows: 4,
                        class: "w-full px-4 py-3 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-gray-50 focus:bg-white transition",
                        placeholder: "Alamat lengkap warung..." %>
      </div>

      <p class="text-xs text-gray-400">Akun login: <%= current_user.email %></p>

      <div class="flex flex-col sm:flex-row gap-3 pt-2">
        <%= f.submit "Simpan Profil",
                     class: "flex-1 py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition cursor-pointer border-0" %>
        <%= link_to "Kembali ke Katalog", store_products_path,
                    class: "flex-1 py-3.5 text-center border border-gray-200 text-gray-600 font-medium rounded-2xl hover:bg-gray-50 transition" %>
      </div>
    <% end %>
  </div>
</div>
