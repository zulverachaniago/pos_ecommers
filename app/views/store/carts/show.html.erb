<% content_for :title, "Keranjang Belanja" %>

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-8 lg:py-10">
  <div class="mb-8">
    <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 tracking-tight">Keranjang Belanja</h1>
    <p class="text-gray-500 mt-1">Review pesanan grosir sebelum checkout.</p>
  </div>

  <% if @cart_items.any? %>
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden divide-y divide-gray-100">
      <% @cart_items.each do |item| %>
        <% variant = item.product_variant %>
        <% product = variant.product %>
        <% snapshot = StockInventory.variant_snapshot(variant, totals: @stock_totals) %>
        <% over_stock = item.quantity > snapshot[:on_hand] %>
        <div class="p-5 flex gap-4 items-start <%= over_stock ? 'bg-red-50/60' : '' %>">
          <%= link_to store_product_path(product), class: "w-14 h-14 bg-sky-50 rounded-2xl flex items-center justify-center text-2xl flex-shrink-0 hover:bg-sky-100 transition" do %>
            📦
          <% end %>
          <div class="flex-1 min-w-0">
            <%= link_to product.name, store_product_path(product), class: "font-semibold text-gray-900 truncate block hover:text-sky-600 transition" %>
            <p class="text-sm text-gray-500"><%= variant.variant_name %></p>
            <p class="text-sm font-semibold text-emerald-600 mt-1">
              Rp <%= number_with_delimiter(variant.price_grosir.to_i) %> / item
            </p>
            <p class="text-xs mt-1 <%= over_stock ? 'text-red-600 font-semibold' : 'text-gray-500' %>">
              Stok tersedia: <%= snapshot[:on_hand] %> <%= variant.unit %>
              <% if over_stock %>
                — melebihi stok!
              <% end %>
            </p>

            <div class="flex items-center gap-2 mt-3">
              <%= button_to "−",
                            update_item_store_cart_path,
                            method: :patch,
                            params: { id: item.id, quantity: item.quantity - 1 },
                            form: { class: "inline" },
                            class: "w-8 h-8 rounded-lg border border-gray-200 text-gray-700 font-bold hover:bg-gray-50 transition bg-white cursor-pointer" %>
              <span class="w-8 text-center text-sm font-semibold text-gray-900"><%= item.quantity %></span>
              <%= button_to "+",
                            update_item_store_cart_path,
                            method: :patch,
                            params: { id: item.id, quantity: item.quantity + 1 },
                            form: { class: "inline" },
                            class: "w-8 h-8 rounded-lg border border-gray-200 text-gray-700 font-bold hover:bg-gray-50 transition bg-white cursor-pointer" %>
            </div>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="font-bold text-gray-900">Rp <%= number_with_delimiter(item.subtotal.to_i) %></p>
            <%= button_to "Hapus",
                          remove_item_store_cart_path,
                          method: :delete,
                          params: { id: item.id },
                          form: { class: "inline", data: { turbo_confirm: "Hapus item ini?" } },
                          class: "mt-2 text-xs text-red-500 hover:text-red-700 font-medium bg-transparent border-0 cursor-pointer p-0" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="mt-6 bg-white rounded-3xl border border-gray-100 shadow-sm p-6">
      <% total = @cart_items.sum(&:subtotal) %>
      <div class="flex items-center justify-between mb-6">
        <span class="text-gray-600 font-medium">Total estimasi</span>
        <span class="text-2xl font-bold text-emerald-600">Rp <%= number_with_delimiter(total.to_i) %></span>
      </div>

      <% unless store_customer_address_ready? %>
        <div class="mb-5 flex gap-3 p-4 bg-amber-50 border border-amber-200 rounded-2xl">
          <span class="text-xl leading-none flex-shrink-0">⚠️</span>
          <div class="text-sm text-amber-900">
            <p class="font-semibold mb-1">Alamat pengiriman belum diisi</p>
            <p class="text-amber-800 mb-3">Lengkapi alamat warung Anda agar pesanan bisa diproses dan dikirim.</p>
            <%= link_to "Isi Alamat Sekarang",
                        edit_store_customer_path(anchor: "address", return_to: "cart"),
                        class: "cart-address-link" %>
          </div>
        </div>
      <% end %>

      <div class="flex flex-col gap-3">
        <div class="flex flex-col sm:flex-row gap-3">
          <%= link_to "Lanjut Belanja", store_products_path,
                      class: "flex-1 py-3.5 text-center border border-gray-200 text-gray-700 font-semibold rounded-2xl hover:bg-gray-50 transition" %>
          <%= link_to "Lihat Wishlist", store_wishlists_path,
                      class: "flex-1 py-3.5 text-center border border-rose-200 text-rose-600 font-semibold rounded-2xl hover:bg-rose-50 transition" %>
        </div>
        <% if store_customer_address_ready? %>
          <%= form_with url: store_orders_path, method: :post, class: "space-y-4" do %>
            <div>
              <p class="text-sm font-semibold text-gray-700 mb-3">Metode Pembayaran</p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <label class="payment-method-option">
                  <input type="radio" name="payment_method" value="cod" checked class="payment-method-option__input">
                  <span class="payment-method-option__box">
                    <span class="payment-method-option__title">💵 Cash (COD)</span>
                    <span class="payment-method-option__desc">Bayar tunai saat barang diterima</span>
                  </span>
                </label>
                <label class="payment-method-option">
                  <input type="radio" name="payment_method" value="transfer" class="payment-method-option__input">
                  <span class="payment-method-option__box">
                    <span class="payment-method-option__title">🏦 Transfer Bank</span>
                    <span class="payment-method-option__desc">Transfer sebelum pengiriman</span>
                  </span>
                </label>
              </div>
            </div>
            <%= button_tag "Pesan Sekarang",
                             type: "submit",
                             class: "w-full py-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl transition shadow-lg shadow-emerald-600/20 border-0 cursor-pointer text-base" %>
          <% end %>
        <% else %>
          <button type="button" disabled
                  class="w-full py-4 bg-gray-200 text-gray-500 font-bold rounded-2xl cursor-not-allowed text-base"
                  title="Isi alamat pengiriman terlebih dahulu">
            Pesan Sekarang
          </button>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-12 text-center">
      <div class="inline-flex items-center justify-center w-20 h-20 bg-gray-100 rounded-3xl text-4xl mb-5">🛒</div>
      <h2 class="text-xl font-bold text-gray-900 mb-2">Keranjang masih kosong</h2>
      <p class="text-gray-500 mb-6">Yuk mulai belanja produk grosir favorit warung Anda.</p>
      <%= link_to "Lihat Katalog", store_products_path,
                  class: "inline-block px-8 py-3.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition" %>
    </div>
  <% end %>
</div>
