<% content_for :page_title, @order.order_number %>
<% content_for :page_subtitle, "Detail pesanan customer" %>

<% customer = @order.customer %>
<% wa_url = whatsapp_url(customer.phone, message: order_whatsapp_message(@order)) %>
<% next_status = @next_statuses.first %>
<% next_label = next_status ? Order::ORDER_STATUS_LABELS[next_status] : nil %>
<% confirming_order = @order.order_status_order? && next_status == "process" %>

<div class="p-6 lg:p-8 space-y-6">
  <%= link_to pos_orders_path(filter: params[:filter].presence || "pending"), class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-emerald-600 transition" do %>
    ← Kembali ke daftar pesanan
  <% end %>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <div class="xl:col-span-2 space-y-6">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
          <div>
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Nomor Pesanan</p>
            <h1 class="text-xl font-bold font-mono text-slate-900"><%= @order.order_number %></h1>
            <p class="text-sm text-slate-500 mt-2">
              <%= @order.order_date&.strftime("%d %B %Y, %H:%M") || @order.created_at.strftime("%d %B %Y, %H:%M") %>
            </p>
          </div>
          <%= render "store/orders/status_badge", order: @order %>
        </div>

        <div class="border-t border-slate-100 pt-5">
          <div class="flex items-center justify-between gap-3 mb-4">
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Produk yang Disiapkan</p>
            <span class="text-xs text-slate-400"><%= @order.order_items.size %> item</span>
          </div>
          <ul class="space-y-3">
            <% @order.order_items.each do |item| %>
              <% variant = item.product_variant %>
              <% product = variant.product %>
              <li class="order-prep-item">
                <span class="order-prep-item__check" aria-hidden="true"></span>
                <div class="flex-1 min-w-0">
                  <p class="font-semibold text-slate-900"><%= product.name %></p>
                  <p class="text-sm text-slate-500"><%= variant.variant_name %></p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-lg font-bold text-emerald-700">× <%= item.quantity %></p>
                  <p class="text-xs text-slate-400">Rp <%= number_with_delimiter(item.subtotal.to_i) %></p>
                </div>
              </li>
            <% end %>
          </ul>
        </div>

        <div class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-between">
          <span class="font-medium text-slate-700">Total Pembayaran</span>
          <span class="text-2xl font-bold text-emerald-600">Rp <%= number_with_delimiter(@order.total_amount.to_i) %></span>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-5">Riwayat Status Pesanan</p>
        <%= render "store/orders/status_timeline", order: @order, records: @status_records %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-4">Informasi Customer</p>
        <p class="font-semibold text-slate-900 text-lg"><%= customer.name %></p>

        <% if customer.phone.present? %>
          <div class="mt-3 flex items-center gap-3">
            <div class="flex-1 min-w-0">
              <p class="text-xs text-slate-400 mb-0.5">Nomor Telepon</p>
              <p class="text-sm font-medium text-slate-800"><%= customer.phone %></p>
            </div>
            <% if wa_url.present? %>
              <%= link_to wa_url,
                          target: "_blank",
                          rel: "noopener noreferrer",
                          class: "whatsapp-followup-btn",
                          title: "Follow up via WhatsApp" do %>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                <span>WhatsApp</span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-amber-600 mt-3">Nomor telepon belum diisi</p>
        <% end %>

        <div class="mt-4 pt-4 border-t border-slate-100">
          <p class="text-xs text-slate-400 mb-1">Alamat Pengiriman</p>
          <% if customer.address.present? %>
            <p class="text-sm text-slate-600 leading-relaxed"><%= customer.address %></p>
          <% else %>
            <p class="text-sm text-amber-600">Alamat belum diisi</p>
          <% end %>
        </div>
      </div>

      <% if @order.order_status_process? || @order.order_status_ship? || @order.order_status_done? %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
          <p class="text-xs text-slate-500 uppercase tracking-wider mb-3">Label Pengiriman</p>
          <p class="text-sm text-slate-500 mb-4">Cetak ulang label untuk kurir dengan QR code pesanan.</p>
          <%= link_to shipping_slip_pos_order_path(@order),
                      class: "inline-flex items-center justify-center gap-2 w-full py-3 border border-emerald-200 text-emerald-700 font-semibold rounded-xl hover:bg-emerald-50 transition text-sm" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0110.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-7.16-4.171L6.34 6m10.94 4.171L17.66 6M6.34 6l1.08 4.829m0 0L12 12.75M7.42 10.829L12 12.75m0 0l4.58-1.921M12 12.75V21" />
            </svg>
            Cetak Label Pengiriman
          <% end %>
        </div>
      <% end %>

      <% if @next_statuses.any? %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
          <% if confirming_order %>
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-2">Konfirmasi & Proses</p>
            <p class="text-sm text-slate-500 mb-4">Setelah follow up WhatsApp, konfirmasi metode pembayaran lalu proses pesanan.</p>
          <% else %>
            <p class="text-xs text-slate-500 uppercase tracking-wider mb-4">Perbarui Status</p>
          <% end %>

          <%= form_with url: pos_order_path(@order), method: :patch, class: "space-y-4" do %>
            <input type="hidden" name="order[order_status]" value="<%= next_status %>">

            <% if confirming_order %>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-3">Metode Pembayaran</label>
                <div class="grid grid-cols-1 gap-3">
                  <label class="payment-method-option">
                    <input type="radio" name="order[payment_method]" value="cod" <%= @order.payment_method_cod? ? "checked" : "" %> class="payment-method-option__input" required>
                    <span class="payment-method-option__box">
                      <span class="payment-method-option__title">💵 Cash on Delivery (COD)</span>
                      <span class="payment-method-option__desc">Bayar tunai saat barang diterima</span>
                    </span>
                  </label>
                  <label class="payment-method-option">
                    <input type="radio" name="order[payment_method]" value="transfer" <%= @order.payment_method_transfer? ? "checked" : "" %> class="payment-method-option__input" required>
                    <span class="payment-method-option__box">
                      <span class="payment-method-option__title">🏦 Transfer Bank</span>
                      <span class="payment-method-option__desc">Customer transfer sebelum/sesudah kirim</span>
                    </span>
                  </label>
                </div>
              </div>
            <% end %>

            <div>
              <label class="block text-sm font-medium text-slate-700 mb-2">Catatan (opsional)</label>
              <textarea name="order[notes]" rows="3" placeholder="<%= confirming_order ? 'Contoh: Customer konfirmasi COD' : 'Contoh: Pesanan sedang dikirim' %>"
                        class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
            </div>
            <button type="submit" class="cashier-order-update-btn w-full">
              <%= next_label %>
            </button>
          <% end %>
        </div>
      <% elsif @order.order_status_done? %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 text-sm text-emerald-800">
          Pesanan sudah selesai.
        </div>
      <% end %>
    </div>
  </div>
</div>
