<% content_for :page_title, "Pesanan Customer" %>
<% content_for :page_subtitle, "Proses pesanan online dari toko" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center">
        <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
        </svg>
      </div>
      <div>
        <% if @filter == "pending" %>
          <p class="text-2xl font-bold text-slate-900"><%= @pending_count %></p>
          <p class="text-sm text-slate-500">Pesanan perlu diproses</p>
        <% else %>
          <p class="text-2xl font-bold text-slate-900"><%= @orders.total_count %></p>
          <p class="text-sm text-slate-500">Total pesanan online</p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2 p-1 bg-slate-100 rounded-xl">
      <%= link_to "Perlu Diproses", pos_orders_path(filter: "pending"),
                  class: "px-4 py-2 text-sm font-semibold rounded-lg transition #{@filter == 'pending' ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'}" %>
      <%= link_to "Semua", pos_orders_path(filter: "all"),
                  class: "px-4 py-2 text-sm font-semibold rounded-lg transition #{@filter == 'all' ? 'bg-white text-emerald-700 shadow-sm' : 'text-slate-600 hover:text-slate-900'}" %>
    </div>
  </div>

  <% if @orders.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">No. Pesanan</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Pelanggan</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Tanggal</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Total</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4 font-mono font-semibold text-slate-900"><%= order.order_number %></td>
                <td class="px-6 py-4 text-slate-700"><%= order.customer.name %></td>
                <td class="px-6 py-4 text-slate-500">
                  <%= order.order_date&.strftime("%d %b %Y, %H:%M") || order.created_at.strftime("%d %b %Y, %H:%M") %>
                </td>
                <td class="px-6 py-4 font-semibold text-slate-900">Rp <%= number_with_delimiter(order.total_amount.to_i) %></td>
                <td class="px-6 py-4">
                  <%= render "store/orders/status_badge", order: order %>
                </td>
                <td class="px-6 py-4 text-center">
                  <%= link_to "Detail", pos_order_path(order, filter: @filter),
                              class: "inline-flex items-center px-4 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 rounded-xl transition" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%= paginate @orders if respond_to?(:paginate) %>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-12 text-center">
      <p class="text-slate-500">
        <% if @filter == "pending" %>
          Tidak ada pesanan yang perlu diproses.
        <% else %>
          Belum ada pesanan online.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
