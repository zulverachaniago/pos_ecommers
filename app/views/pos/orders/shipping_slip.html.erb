<% content_for :page_title, "Label Pengiriman" %>
<% content_for :page_subtitle, @order.order_number %>

<% content_for :head do %>
  <style>
    @media print {
      @page {
        size: 80mm auto;
        margin: 4mm;
      }

      body {
        background: white !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      [data-sidebar-target="sidebar"],
      [data-sidebar-target="overlay"],
      header,
      .delivery-slip-actions,
      .delivery-slip-back {
        display: none !important;
      }

      main {
        overflow: visible !important;
        padding: 0 !important;
      }

      .delivery-slip-page {
        padding: 0 !important;
        margin: 0 !important;
        max-width: none !important;
      }

      .delivery-slip-paper {
        box-shadow: none !important;
        border: none !important;
        border-radius: 0 !important;
        max-width: 80mm !important;
        width: 80mm !important;
        margin: 0 auto !important;
      }
    }
  </style>
<% end %>

<% customer = @order.customer %>
<% total = @order.total_amount.to_i %>
<% payment_label = @order.payment_method_cod? ? "COD (Tunai)" : "Transfer Bank" %>

<div class="delivery-slip-page p-6 lg:p-8 flex flex-col items-center space-y-6">
  <%= link_to pos_order_path(@order),
              class: "delivery-slip-back self-start inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-emerald-600 transition max-w-[320px] w-full" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Kembali ke detail pesanan
  <% end %>

  <article id="delivery-slip" class="delivery-slip-paper w-full max-w-[320px] bg-white border border-slate-200 shadow-sm rounded-sm overflow-hidden font-mono text-[13px] leading-relaxed text-slate-900">
    <header class="text-center px-4 pt-5 pb-3 border-b border-dashed border-slate-300">
      <p class="text-base font-bold tracking-wide uppercase">Oder Store</p>
      <p class="text-[11px] text-slate-500 mt-0.5">Label Pengiriman</p>
      <p class="text-[11px] text-slate-500">================================</p>
    </header>

    <section class="px-4 py-4 text-center border-b border-dashed border-slate-300">
      <div class="inline-flex items-center justify-center delivery-slip-qr">
        <%= order_qr_code(@order, size: 128) %>
      </div>
      <p class="font-bold text-sm mt-3 break-all"><%= @order.order_number %></p>
      <p class="text-[11px] text-slate-500 mt-1">Scan QR untuk verifikasi kurir</p>
    </section>

    <section class="px-4 py-3 space-y-1 text-[12px] border-b border-dashed border-slate-300">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Penerima</p>
      <div class="flex justify-between gap-2">
        <span class="text-slate-500 shrink-0">Nama</span>
        <span class="font-semibold text-right"><%= customer.name %></span>
      </div>
      <div class="flex justify-between gap-2">
        <span class="text-slate-500 shrink-0">Telepon</span>
        <span class="text-right"><%= customer.phone.presence || "-" %></span>
      </div>
      <div class="mt-2">
        <span class="text-slate-500 block mb-1">Alamat Kirim</span>
        <span class="block text-right leading-snug"><%= customer.address.presence || "Alamat belum diisi" %></span>
      </div>
      <div class="flex justify-between gap-2 pt-2">
        <span class="text-slate-500 shrink-0">Tanggal Order</span>
        <span class="text-right"><%= (@order.order_date || @order.created_at).strftime("%d/%m/%Y %H:%M") %></span>
      </div>
    </section>

    <section class="px-4 py-3 border-b border-dashed border-slate-300">
      <p class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2">Daftar Barang</p>
      <div class="space-y-3">
        <% @order.order_items.each do |item| %>
          <% variant = item.product_variant %>
          <% product = variant.product %>
          <% unit_price = item.price_at_sale.to_i %>
          <% subtotal = item.subtotal.to_i %>
          <div>
            <p class="font-semibold leading-snug"><%= product.name %></p>
            <% if variant.variant_name.present? %>
              <p class="text-[11px] text-slate-500"><%= variant.variant_name %></p>
            <% end %>
            <div class="flex justify-between gap-2 mt-0.5">
              <span class="text-slate-600"><%= item.quantity %> x <%= number_with_delimiter(unit_price) %></span>
              <span class="font-semibold whitespace-nowrap"><%= number_with_delimiter(subtotal) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section class="px-4 py-3 border-b border-dashed border-slate-300 space-y-1.5">
      <div class="flex justify-between gap-2">
        <span>Pembayaran</span>
        <span class="font-bold uppercase"><%= payment_label %></span>
      </div>
      <div class="flex justify-between gap-2 text-base pt-1">
        <span class="font-bold">Total Belanja</span>
        <span class="font-bold">Rp <%= number_with_delimiter(total) %></span>
      </div>
    </section>

    <footer class="px-4 py-4 text-center">
      <p class="text-[11px] text-slate-500 mb-1">================================</p>
      <p class="text-[12px] font-semibold">Tempelkan pada paket</p>
      <p class="text-[11px] text-slate-500 mt-1">Pastikan alamat & nomor telepon terbaca jelas</p>
    </footer>
  </article>

  <div class="delivery-slip-actions flex gap-3 w-full max-w-[320px]">
    <%= link_to pos_orders_path(filter: "pending"),
                class: "flex-1 py-3 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition text-sm font-sans text-center" do %>
      Daftar Pesanan
    <% end %>
    <button type="button" onclick="window.print()"
            class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-2xl transition text-sm font-sans">
      Cetak Label
    </button>
  </div>
</div>
