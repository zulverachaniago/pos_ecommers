<% content_for :page_title, "Dashboard Penjualan" %>
<% content_for :page_subtitle, "Ringkasan penjualan kasir & pesanan online" %>

<div class="p-6 lg:p-8 space-y-8">
  <div class="bg-gradient-to-br from-slate-900 via-emerald-900 to-teal-800 rounded-3xl p-6 lg:p-8 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute -top-10 -right-10 w-48 h-48 bg-emerald-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-40 h-40 bg-teal-600 rounded-full blur-3xl"></div>
    </div>
    <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-emerald-200 text-sm font-medium mb-1">
          <%= Time.zone.today.strftime("%A, %d %B %Y") %>
        </p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight">
          Halo, <%= current_user.email.split("@").first.capitalize %> 👋
        </h2>
        <p class="text-emerald-100 mt-2 text-sm lg:text-base">
          Siap melayani transaksi kasir dan pesanan online.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to new_pos_transaction_path,
                    class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white text-emerald-700 font-semibold rounded-2xl hover:bg-emerald-50 transition text-sm shadow-lg" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Buka POS
        <% end %>
        <%= link_to pos_orders_path(filter: "pending"),
                    class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white/20 border border-white/20 font-semibold rounded-2xl transition text-sm" do %>
          Pesanan Customer
          <% if @pending_online_orders > 0 %>
            <span class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 text-[10px] font-bold bg-amber-400 text-slate-900 rounded-full"><%= @pending_online_orders %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
      <p class="text-3xl font-bold text-slate-900">Rp <%= number_with_delimiter(@today_metrics.combined_sales.to_i) %></p>
      <p class="text-sm text-slate-500 mt-1">Penjualan Hari Ini</p>
      <p class="text-xs text-slate-400 mt-2">
        POS Rp <%= number_with_delimiter(@today_metrics.pos_sales.to_i) %> ·
        Online Rp <%= number_with_delimiter(@today_metrics.online_sales.to_i) %>
      </p>
    </div>

    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
      <p class="text-3xl font-bold text-slate-900"><%= @today_metrics.combined_count %></p>
      <p class="text-sm text-slate-500 mt-1">Transaksi Hari Ini</p>
      <p class="text-xs text-slate-400 mt-2">
        POS <%= @today_metrics.pos_count %> · Online <%= @today_metrics.online_count %>
      </p>
    </div>

    <%= link_to pos_orders_path(filter: "pending"), class: "bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:border-amber-200 hover:shadow-md transition" do %>
      <p class="text-3xl font-bold text-amber-600"><%= @pending_online_orders %></p>
      <p class="text-sm text-slate-500 mt-1">Pesanan Perlu Diproses</p>
      <% if @new_online_orders > 0 %>
        <p class="text-xs text-amber-600 mt-2"><%= @new_online_orders %> pesanan baru menunggu</p>
      <% end %>
    <% end %>

    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
      <p class="text-3xl font-bold text-slate-900">Rp <%= number_with_delimiter(@week_metrics.combined_sales.to_i) %></p>
      <p class="text-sm text-slate-500 mt-1">Penjualan Minggu Ini</p>
      <p class="text-xs text-slate-400 mt-2">POS + Online</p>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Transaksi POS Terbaru</h3>
        <%= link_to "Lihat Semua", pos_transactions_path, class: "text-xs font-medium text-emerald-600 hover:text-emerald-700" %>
      </div>

      <% if @recent_transactions.any? %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                  <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase">No. Transaksi</th>
                  <th class="px-5 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
                  <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Waktu</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @recent_transactions.each do |tx| %>
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="px-5 py-3">
                      <%= link_to tx.transaction_number, pos_transaction_path(tx), class: "font-mono text-xs font-semibold text-slate-900 hover:text-emerald-600" %>
                      <p class="text-xs text-slate-500"><%= tx.customer&.name || "—" %></p>
                    </td>
                    <td class="px-5 py-3 text-right font-semibold text-emerald-600">
                      Rp <%= number_with_delimiter(tx.total_amount.to_i) %>
                    </td>
                    <td class="px-5 py-3 text-slate-500 text-xs">
                      <%= tx.created_at.strftime("%d/%m %H:%M") %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-12 px-6">
          <p class="text-slate-500 text-sm">Belum ada transaksi POS.</p>
        </div>
      <% end %>
    </div>

    <div>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Pesanan Online Terbaru</h3>
        <%= link_to "Lihat Semua", pos_orders_path, class: "text-xs font-medium text-emerald-600 hover:text-emerald-700" %>
      </div>

      <% if @recent_online_orders.any? %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-100">
                  <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase">No. Pesanan</th>
                  <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
                  <th class="px-5 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @recent_online_orders.each do |order| %>
                  <tr class="hover:bg-slate-50/80 transition">
                    <td class="px-5 py-3">
                      <%= link_to order.order_number, pos_order_path(order), class: "font-mono text-xs font-semibold text-slate-900 hover:text-emerald-600" %>
                      <p class="text-xs text-slate-500"><%= order.customer.name %></p>
                    </td>
                    <td class="px-5 py-3">
                      <%= render "store/orders/status_badge", order: order %>
                    </td>
                    <td class="px-5 py-3 text-right font-semibold text-emerald-600">
                      Rp <%= number_with_delimiter(order.total_amount.to_i) %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-12 px-6">
          <p class="text-slate-500 text-sm">Belum ada pesanan online.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
