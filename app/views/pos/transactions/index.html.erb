<% content_for :page_title, "Riwayat POS" %>
<% content_for :page_subtitle, "Daftar transaksi kasir terbaru" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center">
        <svg class="w-6 h-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-2xl font-bold text-slate-900"><%= @transactions.total_count %></p>
        <p class="text-sm text-slate-500">Transaksi terakhir</p>
      </div>
    </div>
    <%= link_to new_pos_transaction_path,
                class: "inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-2xl transition shadow-lg shadow-emerald-600/20 text-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Transaksi Baru
    <% end %>
  </div>

  <% if @transactions.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">No. Transaksi</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Pelanggan</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Kasir</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Pembayaran</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Total</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Waktu</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @transactions.each do |tx| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4 font-mono text-xs font-semibold text-slate-900"><%= tx.transaction_number %></td>
                <td class="px-6 py-4 text-slate-600"><%= tx.customer&.name || "—" %></td>
                <td class="px-6 py-4 text-slate-500 text-xs"><%= tx.user&.email %></td>
                <td class="px-6 py-4">
                  <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full capitalize">
                    <%= tx.payment_method %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right font-semibold text-emerald-600">
                  Rp <%= number_with_delimiter(tx.total_amount.to_i) %>
                </td>
                <td class="px-6 py-4 text-slate-500 text-xs">
                  <%= tx.created_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="px-6 py-4 text-center">
                  <%= link_to "Detail", pos_transaction_path(tx),
                              class: "text-sky-600 hover:underline text-xs font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @transactions %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-20 px-6">
      <div class="text-5xl mb-4">🧾</div>
      <h3 class="text-lg font-semibold text-slate-900 mb-2">Belum ada transaksi</h3>
      <p class="text-slate-500 text-sm mb-6">Mulai transaksi penjualan pertama di kasir.</p>
      <%= link_to "Buka Kasir", new_pos_transaction_path,
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 text-white font-semibold rounded-2xl hover:bg-emerald-700 transition text-sm" %>
    </div>
  <% end %>
</div>
