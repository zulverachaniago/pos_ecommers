<% content_for :page_title, "Inventori Stok" %>
<% content_for :page_subtitle, "Catat penambahan, penyesuaian, pengeluaran, dan riwayat perubahan stok" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <%= link_to new_admin_stock_movement_path(type: "stock_in"),
                class: "flex items-center gap-4 p-5 bg-white rounded-2xl border border-emerald-100 shadow-sm hover:shadow-md hover:border-emerald-300 transition group" do %>
      <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center group-hover:bg-emerald-600 transition">
        <svg class="w-6 h-6 text-emerald-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Penambahan Stok</p>
        <p class="text-xs text-slate-500">Barang masuk dari supplier</p>
      </div>
    <% end %>

    <%= link_to new_admin_stock_movement_path(type: "adjustment"),
                class: "flex items-center gap-4 p-5 bg-white rounded-2xl border border-amber-100 shadow-sm hover:shadow-md hover:border-amber-300 transition group" do %>
      <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center group-hover:bg-amber-500 transition">
        <svg class="w-6 h-6 text-amber-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Penyesuaian Stok</p>
        <p class="text-xs text-slate-500">Koreksi stok fisik (+/-)</p>
      </div>
    <% end %>

    <%= link_to new_admin_stock_movement_path(type: "stock_out"),
                class: "flex items-center gap-4 p-5 bg-white rounded-2xl border border-orange-100 shadow-sm hover:shadow-md hover:border-orange-300 transition group" do %>
      <div class="w-12 h-12 bg-orange-100 rounded-2xl flex items-center justify-center group-hover:bg-orange-500 transition">
        <svg class="w-6 h-6 text-orange-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15" />
        </svg>
      </div>
      <div>
        <p class="font-semibold text-slate-900">Pengeluaran Stok</p>
        <p class="text-xs text-slate-500">Barang keluar manual</p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Semua",
                admin_stock_movements_path,
                class: "px-4 py-2 text-sm font-medium rounded-xl transition #{params[:type].blank? ? 'bg-sky-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% %w[stock_in adjustment stock_out pos_sale order_sale].each do |type| %>
      <%= link_to StockMovement::MOVEMENT_TYPE_LABELS[type],
                  admin_stock_movements_path(type: type),
                  class: "px-4 py-2 text-sm font-medium rounded-xl transition #{params[:type] == type ? 'bg-sky-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'}" %>
    <% end %>
  </div>

  <% if @movements.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 border-b border-slate-100">
            <tr>
              <th class="text-left px-5 py-3 font-semibold text-slate-600">Tanggal</th>
              <th class="text-left px-5 py-3 font-semibold text-slate-600">Jenis</th>
              <th class="text-left px-5 py-3 font-semibold text-slate-600">Produk</th>
              <th class="text-right px-5 py-3 font-semibold text-slate-600">Qty</th>
              <th class="text-right px-5 py-3 font-semibold text-slate-600">Stok Sebelum</th>
              <th class="text-right px-5 py-3 font-semibold text-slate-600">Stok Sesudah</th>
              <th class="text-left px-5 py-3 font-semibold text-slate-600">Referensi</th>
              <th class="text-left px-5 py-3 font-semibold text-slate-600">Oleh</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @movements.each do |movement| %>
              <tr class="hover:bg-slate-50/80">
                <td class="px-5 py-3 text-slate-600 whitespace-nowrap">
                  <%= l(movement.created_at, format: :short) rescue movement.created_at.strftime("%d/%m/%Y %H:%M") %>
                </td>
                <td class="px-5 py-3">
                  <%= render "movement_type_badge", movement: movement %>
                </td>
                <td class="px-5 py-3">
                  <p class="font-medium text-slate-900"><%= movement.product_variant.product.name %></p>
                  <p class="text-xs text-slate-500"><%= movement.product_variant.variant_name %></p>
                </td>
                <td class="px-5 py-3 text-right font-semibold <%= movement.quantity.positive? ? 'text-emerald-600' : 'text-red-600' %>">
                  <%= movement.quantity_label %>
                </td>
                <td class="px-5 py-3 text-right text-slate-600"><%= movement.stock_before %></td>
                <td class="px-5 py-3 text-right font-medium text-slate-900"><%= movement.stock_after %></td>
                <td class="px-5 py-3 text-slate-600">
                  <p><%= movement.reference_label %></p>
                  <% if movement.notes.present? %>
                    <p class="text-xs text-slate-400 mt-0.5"><%= movement.notes %></p>
                  <% end %>
                </td>
                <td class="px-5 py-3 text-slate-600 whitespace-nowrap"><%= movement.user.email %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @movements %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-20 px-6">
      <div class="w-16 h-16 bg-sky-50 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">📦</div>
      <h3 class="text-lg font-semibold text-slate-900 mb-2">Belum ada perubahan stok</h3>
      <p class="text-slate-500 text-sm mb-6">Mulai dengan penambahan stok atau catat stok awal produk.</p>
      <%= link_to "Penambahan Stok", new_admin_stock_movement_path(type: "stock_in"),
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition text-sm" %>
    </div>
  <% end %>
</div>
