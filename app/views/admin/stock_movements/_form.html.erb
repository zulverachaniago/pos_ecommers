<%# locals: movement, movement_type, variants %>
<%= form_with model: movement, url: admin_stock_movements_path(type: movement_type), class: "space-y-6" do |f| %>
  <%= f.hidden_field :movement_type, value: movement_type %>

  <div>
    <%= f.label :product_variant_id, "Produk / Varian", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.collection_select :product_variant_id,
                            variants,
                            :id,
                            ->(v) { "#{v.display_name} — stok: #{v.current_stock} #{v.unit}" },
                            { prompt: "Pilih produk..." },
                            class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-2 focus:ring-sky-500 focus:border-sky-500" %>
  </div>

  <div>
    <%= f.label :quantity, "Jumlah", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.number_field :quantity,
                       min: movement_type == "adjustment" ? nil : 1,
                       step: 1,
                       required: true,
                       class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-2 focus:ring-sky-500 focus:border-sky-500" %>
    <% case movement_type %>
    <% when "stock_in" %>
      <p class="mt-2 text-xs text-slate-500">Masukkan jumlah barang yang ditambahkan (positif).</p>
    <% when "stock_out" %>
      <p class="mt-2 text-xs text-slate-500">Masukkan jumlah barang yang dikeluarkan (positif).</p>
    <% when "adjustment" %>
      <p class="mt-2 text-xs text-slate-500">Masukkan selisih penyesuaian: positif untuk menambah, negatif untuk mengurangi stok.</p>
    <% end %>
  </div>

  <div>
    <%= f.label :notes, "Catatan", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.text_area :notes,
                    rows: 3,
                    placeholder: "Contoh: stok dari supplier, rusak, sample, dll.",
                    class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-sm focus:ring-2 focus:ring-sky-500 focus:border-sky-500" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit "Simpan",
                 class: "inline-flex items-center justify-center px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition shadow-lg shadow-sky-600/20 text-sm cursor-pointer" %>
    <%= link_to "Batal", admin_stock_movements_path,
                class: "inline-flex items-center justify-center px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-2xl transition text-sm" %>
  </div>
<% end %>
