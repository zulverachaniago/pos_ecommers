<% content_for :page_title, StockMovement::MOVEMENT_TYPE_LABELS[@movement_type] %>
<% content_for :page_subtitle, "Catat perubahan stok produk" %>

<div class="p-6 lg:p-8 max-w-2xl">
  <%= link_to admin_stock_movements_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 mb-6 transition" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Kembali ke riwayat stok
  <% end %>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 lg:p-8">
    <%= render "form", movement: @movement, movement_type: @movement_type, variants: @variants %>
  </div>
</div>
