<% content_for :page_title, "Dashboard" %>
<% content_for :page_subtitle, "Ringkasan bisnis Oder Store hari ini" %>

<div class="p-6 lg:p-8 space-y-8">
  <!-- Welcome banner -->
  <div class="bg-gradient-to-br from-slate-900 via-sky-900 to-sky-800 rounded-3xl p-6 lg:p-8 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute -top-10 -right-10 w-48 h-48 bg-sky-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-1/3 w-40 h-40 bg-blue-600 rounded-full blur-3xl"></div>
    </div>
    <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-sky-200 text-sm font-medium mb-1">
          <%= Time.zone.today.strftime("%A, %d %B %Y") %>
        </p>
        <h2 class="text-2xl lg:text-3xl font-bold tracking-tight">
          Halo, <%= current_user.email.split("@").first.capitalize %> 👋
        </h2>
        <p class="text-sky-100 mt-2 text-sm lg:text-base">
          Berikut ringkasan data agen kelontong Anda saat ini.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to new_admin_product_path,
                    class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white text-sky-700 font-semibold rounded-2xl hover:bg-sky-50 transition text-sm shadow-lg" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Tambah Produk
        <% end %>
        <%= link_to new_pos_transaction_path,
                    class: "inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 hover:bg-white/20 border border-white/20 font-semibold rounded-2xl transition text-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
          </svg>
          Buka POS
        <% end %>
      </div>
    </div>
  </div>

  <!-- Stat cards — Master Data -->
  <div>
    <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Master Data</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-5">
      <%= link_to admin_products_path, class: "group bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:border-sky-200 transition" do %>
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-sky-100 rounded-xl flex items-center justify-center group-hover:bg-sky-600 transition">
            <svg class="w-5 h-5 text-sky-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
          </div>
          <span class="text-xs font-medium text-sky-600 bg-sky-50 px-2.5 py-1 rounded-full">
            <%= @active_products %> aktif
          </span>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @total_products %></p>
        <p class="text-sm text-slate-500 mt-1">Total Produk</p>
      <% end %>

      <%= link_to admin_categories_path, class: "group bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:border-emerald-200 transition" do %>
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-emerald-100 rounded-xl flex items-center justify-center group-hover:bg-emerald-600 transition">
            <svg class="w-5 h-5 text-emerald-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @total_categories %></p>
        <p class="text-sm text-slate-500 mt-1">Total Kategori</p>
      <% end %>

      <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-violet-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @total_variants %></p>
        <p class="text-sm text-slate-500 mt-1">Total Varian Produk</p>
      </div>

      <%= link_to admin_stock_movements_path, class: "group bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:border-amber-200 transition" do %>
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-amber-100 rounded-xl flex items-center justify-center group-hover:bg-amber-500 transition">
            <svg class="w-5 h-5 text-amber-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
            </svg>
          </div>
          <% if @low_stock_count.positive? || @out_of_stock_count.positive? %>
            <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full">Perlu perhatian</span>
          <% end %>
        </div>
        <p class="text-3xl font-bold text-amber-600"><%= @low_stock_count + @out_of_stock_count %></p>
        <p class="text-sm text-slate-500 mt-1">Varian Stok Rendah / Habis</p>
        <p class="text-xs text-slate-400 mt-2"><%= @out_of_stock_count %> habis · <%= @low_stock_count %> menipis</p>
      <% end %>

      <%= link_to admin_suppliers_path, class: "group bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md hover:border-amber-200 transition" do %>
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-amber-100 rounded-xl flex items-center justify-center group-hover:bg-amber-500 transition">
            <svg class="w-5 h-5 text-amber-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @total_suppliers %></p>
        <p class="text-sm text-slate-500 mt-1">Total Supplier</p>
      <% end %>
    </div>
  </div>

  <!-- Stat cards — Operasional -->
  <div>
    <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Operasional Hari Ini</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
      <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-green-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <p class="text-2xl lg:text-3xl font-bold text-emerald-600">
          Rp <%= number_with_delimiter(@today_metrics.combined_sales.to_i) %>
        </p>
        <p class="text-sm text-slate-500 mt-1">Penjualan Hari Ini</p>
        <p class="text-xs text-slate-400 mt-2">
          POS Rp <%= number_with_delimiter(@today_metrics.pos_sales.to_i) %> ·
          Online Rp <%= number_with_delimiter(@today_metrics.online_sales.to_i) %>
        </p>
      </div>

      <%= link_to admin_orders_path, class: "bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:border-orange-200 hover:shadow-md transition" do %>
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-orange-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <% if @pending_orders > 0 %>
            <span class="text-xs font-medium text-orange-600 bg-orange-50 px-2.5 py-1 rounded-full animate-pulse">
              Perlu tindakan
            </span>
          <% end %>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @pending_orders %></p>
        <p class="text-sm text-slate-500 mt-1">Pesanan Baru (Order)</p>
        <p class="text-xs text-slate-400 mt-2"><%= @processing_orders %> sedang diproses/dikirim</p>
      <% end %>

      <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-violet-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-violet-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @online_orders_today %></p>
        <p class="text-sm text-slate-500 mt-1">Pesanan Online Hari Ini</p>
      </div>

      <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div class="w-11 h-11 bg-blue-100 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-slate-900"><%= @total_customers %></p>
        <p class="text-sm text-slate-500 mt-1">Total Pelanggan</p>
      </div>
    </div>
  </div>

  <% if @recent_online_orders.any? %>
    <div>
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Pesanan Online Terbaru</h3>
        <%= link_to "Kelola Pesanan", admin_orders_path, class: "text-xs font-medium text-sky-600 hover:text-sky-700" %>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-50 border-b border-slate-100">
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">No. Pesanan</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Pelanggan</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
                <th class="px-6 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @recent_online_orders.each do |order| %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="px-6 py-3 font-mono text-xs font-semibold">
                    <%= link_to order.order_number, admin_order_path(order), class: "text-slate-900 hover:text-sky-600" %>
                  </td>
                  <td class="px-6 py-3 text-slate-600"><%= order.customer.name %></td>
                  <td class="px-6 py-3"><%= render "store/orders/status_badge", order: order %></td>
                  <td class="px-6 py-3 text-right font-semibold text-emerald-600">Rp <%= number_with_delimiter(order.total_amount.to_i) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Quick actions -->
  <div>
    <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Aksi Cepat</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <%= link_to new_admin_product_path,
                  class: "flex flex-col items-center gap-3 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-sky-200 transition text-center group" do %>
        <div class="w-12 h-12 bg-sky-50 rounded-2xl flex items-center justify-center group-hover:bg-sky-600 transition">
          <svg class="w-6 h-6 text-sky-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <span class="text-sm font-medium text-slate-700">Tambah Produk</span>
      <% end %>

      <%= link_to new_admin_category_path,
                  class: "flex flex-col items-center gap-3 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-emerald-200 transition text-center group" do %>
        <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center group-hover:bg-emerald-600 transition">
          <svg class="w-6 h-6 text-emerald-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <span class="text-sm font-medium text-slate-700">Tambah Kategori</span>
      <% end %>

      <%= link_to new_admin_supplier_path,
                  class: "flex flex-col items-center gap-3 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-amber-200 transition text-center group" do %>
        <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center group-hover:bg-amber-500 transition">
          <svg class="w-6 h-6 text-amber-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </div>
        <span class="text-sm font-medium text-slate-700">Tambah Supplier</span>
      <% end %>

      <%= link_to admin_orders_path,
                  class: "flex flex-col items-center gap-3 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-orange-200 transition text-center group" do %>
        <div class="w-12 h-12 bg-orange-50 rounded-2xl flex items-center justify-center group-hover:bg-orange-500 transition">
          <svg class="w-6 h-6 text-orange-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
          </svg>
        </div>
        <span class="text-sm font-medium text-slate-700">Pesanan Online</span>
      <% end %>

      <%= link_to store_root_path,
                  target: "_blank",
                  class: "flex flex-col items-center gap-3 bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md hover:border-violet-200 transition text-center group" do %>
        <div class="w-12 h-12 bg-violet-50 rounded-2xl flex items-center justify-center group-hover:bg-violet-600 transition">
          <svg class="w-6 h-6 text-violet-600 group-hover:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </div>
        <span class="text-sm font-medium text-slate-700">Lihat Toko</span>
      <% end %>
    </div>
  </div>
</div>
