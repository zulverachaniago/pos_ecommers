<% role_labels = {
  "admin" => "Admin",
  "cashier" => "Kasir",
  "owner" => "Owner",
  "customer" => "Customer",
  "courier" => "Kurir"
} %>
<% role_styles = {
  "admin" => "bg-violet-100 text-violet-700",
  "cashier" => "bg-sky-100 text-sky-700",
  "owner" => "bg-amber-100 text-amber-700",
  "customer" => "bg-emerald-100 text-emerald-700",
  "courier" => "bg-blue-100 text-blue-700"
} %>
<% if role_name.present? %>
  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium <%= role_styles.fetch(role_name, "bg-slate-100 text-slate-600") %>">
    <%= role_labels.fetch(role_name, role_name.titleize) %>
  </span>
<% else %>
  <span class="text-slate-400">—</span>
<% end %>
