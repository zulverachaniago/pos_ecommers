<%= form_with(model: [:admin, user], class: "space-y-6") do |f| %>

  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl text-sm">
      <p class="font-semibold mb-2"><%= pluralize(user.errors.count, "kesalahan") %> perlu diperbaiki:</p>
      <ul class="list-disc list-inside space-y-1">
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.email_field :email,
                      autocomplete: "email",
                      class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                      placeholder: "nama@warung.com" %>
  </div>

  <div>
    <%= label_tag "user_role", "Role", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= select_tag "user[role]",
                   options_for_select(@roles.map { |r| [r.titleize, r] }, user.roles.first&.name),
                   class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                   data: { tom_select_search: "false" } %>
    <p class="text-xs text-slate-400 mt-1.5">Admin: akses penuh · Kasir: POS · Owner: manajemen toko</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= f.label :password, user.persisted? ? "Password Baru" : "Password", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.password_field :password,
                           autocomplete: user.persisted? ? "new-password" : "new-password",
                           class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                           placeholder: user.persisted? ? "Kosongkan jika tidak diubah" : "Minimal 6 karakter" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Konfirmasi Password", class: "block text-sm font-medium text-slate-700 mb-2" %>
      <%= f.password_field :password_confirmation,
                           autocomplete: "new-password",
                           class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                           placeholder: "Ulangi password" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <%= f.submit "Simpan Pengguna",
                 class: "px-8 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition cursor-pointer shadow-sm" %>
    <%= link_to "Batal", admin_users_path,
                class: "px-8 py-3 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition" %>
  </div>

<% end %>
