<% content_for :page_title, "Master Produk" %>
<% content_for :page_subtitle, "Kelola katalog produk dan varian harga grosir" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-sky-100 rounded-2xl flex items-center justify-center">
        <svg class="w-6 h-6 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
      </div>
      <div>
        <p class="text-2xl font-bold text-slate-900"><%= @products.total_count %></p>
        <p class="text-sm text-slate-500">Total produk terdaftar</p>
      </div>
    </div>
    <%= link_to new_admin_product_path,
                class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition shadow-lg shadow-sky-600/20 text-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Tambah Produk
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 lg:p-6">
    <%= search_form_for @q, url: admin_products_path, html: { class: "space-y-4", method: :get } do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="form-field min-w-0">
          <%= f.label :name_cont, "Nama Produk", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= f.search_field :name_cont,
                             class: "form-control w-full px-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                             placeholder: "Cari nama produk..." %>
        </div>
        <div class="form-field min-w-0">
          <%= f.label :sku_cont, "SKU", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= f.search_field :sku_cont,
                             class: "form-control w-full px-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                             placeholder: "Cari SKU..." %>
        </div>
        <div class="form-field min-w-0">
          <%= f.label :category_id_eq, "Kategori", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= f.select :category_id_eq,
                       options_from_collection_for_select(@categories, :id, :name, @q.category_id_eq),
                       { include_blank: "Semua kategori" },
                       class: "form-select-native w-full",
                       data: { tom_select_search: "false" } %>
        </div>
        <div class="form-field min-w-0">
          <%= f.label :is_active_eq, "Status", class: "block text-sm font-medium text-slate-700 mb-2" %>
          <%= f.select :is_active_eq,
                       [["Semua status", ""], ["Aktif", true], ["Nonaktif", false]],
                       {},
                       class: "form-select-native w-full",
                       data: { tom_select_search: "false" } %>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= f.submit "Cari",
                     class: "inline-flex items-center justify-center px-6 py-2.5 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition text-sm cursor-pointer border-0" %>
        <%= link_to "Reset",
                    admin_products_path,
                    class: "inline-flex items-center justify-center px-6 py-2.5 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition text-sm" %>
      </div>
    <% end %>
  </div>

  <% if @products.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Produk</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Kategori</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Varian</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Harga Grosir</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Stok</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Status Stok</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @products.each do |product| %>
              <% min_price = product.product_variants.map(&:price_grosir).compact.min %>
              <% total_stock = product_total_stock(product, @stock_totals) %>
              <% stock_status = product_stock_status(product, @stock_totals) %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <% if product.image.attached? %>
                      <%= link_to url_for(product.image),
                                  target: "_blank",
                                  rel: "noopener",
                                  class: "flex-shrink-0 block w-10 h-10 rounded-xl overflow-hidden border border-slate-200 hover:opacity-90 transition",
                                  title: "Lihat gambar produk" do %>
                        <%= image_tag product.image,
                                      class: "w-full h-full object-cover",
                                      alt: product.name %>
                      <% end %>
                    <% else %>
                      <div class="w-10 h-10 bg-gradient-to-br from-sky-100 to-blue-100 rounded-xl flex items-center justify-center text-lg flex-shrink-0">
                        🛍️
                      </div>
                    <% end %>
                    <div>
                      <p class="font-semibold text-slate-900"><%= product.name %></p>
                      <% if product.sku.present? %>
                        <p class="text-xs text-slate-400 mt-0.5">SKU: <%= product.sku %></p>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <% if product.category %>
                    <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-full">
                      <%= product.category.name %>
                    </span>
                  <% else %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-center">
                  <span class="inline-flex items-center justify-center w-8 h-8 bg-violet-50 text-violet-700 font-semibold rounded-lg text-xs">
                    <%= product.product_variants.size %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  <% if min_price %>
                    <p class="font-semibold text-emerald-600">Rp <%= number_with_delimiter(min_price.to_i) %></p>
                    <p class="text-xs text-slate-400">mulai dari</p>
                  <% else %>
                    <span class="text-slate-400">—</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-right">
                  <p class="font-semibold text-slate-900"><%= number_with_delimiter(total_stock) %></p>
                  <p class="text-xs text-slate-400"><%= product.product_variants.size %> varian</p>
                </td>
                <td class="px-6 py-4 text-center">
                  <%= render "shared/stock_status_badge", status: stock_status, compact: true %>
                </td>
                <td class="px-6 py-4 text-center">
                  <% if product.is_active %>
                    <span class="inline-flex px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-medium rounded-full">Aktif</span>
                  <% else %>
                    <span class="inline-flex px-2.5 py-1 bg-slate-100 text-slate-500 text-xs font-medium rounded-full">Nonaktif</span>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-center gap-2">
                    <%= link_to edit_admin_product_path(product),
                                class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sky-600 hover:bg-sky-50 rounded-xl text-xs font-medium transition" do %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
                      </svg>
                      Edit
                    <% end %>
                    <%= link_to admin_product_path(product),
                                data: { turbo_method: :delete, turbo_confirm: "Yakin hapus produk ini beserta variannya?" },
                                class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-red-600 hover:bg-red-50 rounded-xl text-xs font-medium transition" do %>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                      </svg>
                      Hapus
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @products %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-20 px-6">
      <div class="w-16 h-16 bg-sky-50 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">📦</div>
      <% if params[:q].present? %>
        <h3 class="text-lg font-semibold text-slate-900 mb-2">Produk tidak ditemukan</h3>
        <p class="text-slate-500 text-sm mb-6">Tidak ada produk yang cocok dengan filter pencarian.</p>
        <%= link_to "Reset Pencarian", admin_products_path,
                    class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition text-sm" %>
      <% else %>
        <h3 class="text-lg font-semibold text-slate-900 mb-2">Belum ada produk</h3>
        <p class="text-slate-500 text-sm mb-6">Mulai tambahkan produk pertama ke katalog grosir Anda.</p>
        <%= link_to "Tambah Produk Pertama", new_admin_product_path,
                    class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition text-sm" %>
      <% end %>
    </div>
  <% end %>
</div>
