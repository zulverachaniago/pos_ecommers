<% input_class = "form-control w-full px-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition" %>
<% select_class = "form-select-native w-full" %>
<% label_class = "block text-sm font-medium text-slate-700 mb-2" %>

<%= form_with(model: [:admin, product], class: "space-y-8", html: { multipart: true }) do |f| %>

  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl text-sm">
      <p class="font-semibold mb-2"><%= pluralize(product.errors.count, "kesalahan") %> perlu diperbaiki:</p>
      <ul class="list-disc list-inside space-y-1">
        <% product.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Basic Info -->
  <div>
    <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Informasi Produk</h3>

    <div class="form-field min-w-0 mb-6"
         data-controller="qr-scanner"
         data-qr-scanner-submit-on-scan-value="false"
         data-qr-scanner-barcode-mode-value="true">
      <%= f.label :barcode, "Barcode", class: label_class %>
      <div class="flex gap-2">
        <%= f.text_field :barcode,
                         class: "#{input_class} flex-1 min-w-0 font-mono",
                         placeholder: "Ketik atau scan barcode produk",
                         autocomplete: "off",
                         data: { qr_scanner_target: "input" } %>
        <button type="button"
                class="barcode-scan-btn flex-shrink-0"
                title="Scan barcode dengan kamera"
                data-action="click->qr-scanner#open">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
          </svg>
        </button>
      </div>
      <p class="text-xs text-slate-500 mt-2">Ketik manual atau tap ikon kamera untuk scan barcode (EAN, UPC, Code 128, dll.)</p>

      <div class="qr-scanner-modal hidden" data-qr-scanner-target="modal">
        <div class="qr-scanner-modal__backdrop" data-action="click->qr-scanner#close"></div>
        <div class="qr-scanner-modal__panel">
          <div class="flex items-center justify-between mb-4">
            <p class="font-semibold text-slate-900">Scan Barcode Produk</p>
            <button type="button" class="text-slate-500 hover:text-slate-800" data-action="click->qr-scanner#close">✕</button>
          </div>
          <div id="product-barcode-reader" class="qr-scanner-reader" data-qr-scanner-target="reader"></div>
          <p class="text-xs text-slate-500 mt-3 text-center">Arahkan kamera ke barcode pada kemasan produk</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <div class="form-field min-w-0">
        <%= f.label :name, "Nama Produk", class: label_class %>
        <%= f.text_field :name, class: input_class, placeholder: "Contoh: Indomie Goreng" %>
      </div>
      <div class="form-field min-w-0">
        <%= f.label :category_id, "Kategori", class: label_class %>
        <%= f.collection_select :category_id, Category.order(:name), :id, :name,
                               { prompt: "Pilih Kategori" },
                               class: select_class,
                               data: { tom_select_search: "false" } %>
      </div>
    </div>
  </div>

  <div>
    <%= f.label :description, "Deskripsi", class: label_class %>
    <%= f.text_area :description, rows: 3, class: input_class, placeholder: "Deskripsi singkat produk..." %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="form-field min-w-0">
      <%= f.label :sku, "SKU", class: label_class %>
      <%= f.text_field :sku, class: input_class, placeholder: "Kode SKU" %>
    </div>
    <div class="form-field min-w-0">
      <%= f.label :is_active, "Status", class: label_class %>
      <label class="flex items-center gap-3 cursor-pointer select-none w-full h-12 px-4 bg-slate-50 border border-slate-200 rounded-2xl hover:bg-white transition box-border">
        <%= f.check_box :is_active, class: "w-5 h-5 rounded text-sky-600 focus:ring-sky-500 flex-shrink-0" %>
        <span class="text-sm font-medium text-slate-700">Produk Aktif</span>
      </label>
    </div>
  </div>

  <div>
    <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Foto Produk</h3>
    <div class="flex flex-col sm:flex-row sm:items-start gap-6">
      <% if product.image.attached? %>
        <div class="flex-shrink-0">
          <%= image_tag product.image,
                        class: "w-36 h-36 object-cover rounded-2xl border border-slate-200 bg-slate-50",
                        alt: product.name %>
          <p class="text-xs text-slate-500 mt-2 text-center max-w-[9rem] truncate"><%= product.image.filename %></p>
        </div>
      <% else %>
        <div class="flex-shrink-0 w-36 h-36 bg-slate-50 border border-dashed border-slate-200 rounded-2xl flex flex-col items-center justify-center gap-2 text-slate-400">
          <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
          </svg>
          <span class="text-xs">Belum ada foto</span>
        </div>
      <% end %>
      <div class="form-field min-w-0 flex-1">
        <%= f.label :image, "Upload Gambar", class: label_class %>
        <%= f.file_field :image,
                         accept: "image/png,image/jpeg,image/webp,image/gif",
                         class: "block w-full text-sm text-slate-600 file:mr-4 file:py-2.5 file:px-5 file:rounded-2xl file:border-0 file:text-sm file:font-semibold file:bg-sky-50 file:text-sky-700 hover:file:bg-sky-100 cursor-pointer" %>
        <p class="text-xs text-slate-500 mt-2">JPG, PNG, WebP, atau GIF — maks. 5 MB.<% if product.persisted? %> Kosongkan jika tidak ingin mengubah gambar.<% end %></p>
      </div>
    </div>
  </div>

  <!-- Product Variants -->
  <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6" data-controller="add-variant">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
      <div>
        <h3 class="font-semibold text-slate-900">Varian Produk</h3>
        <p class="text-sm text-slate-500">Kemasan, satuan, dan harga grosir/ecer</p>
      </div>
      <%= link_to "#",
                  data: { action: "click->add-variant#add" },
                  class: "inline-flex items-center gap-2 px-5 py-2.5 text-sky-600 border border-sky-200 bg-white rounded-2xl hover:bg-sky-50 font-medium text-sm transition" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Tambah Varian
      <% end %>
    </div>

    <template data-add-variant-target="template">
      <div class="bg-white border border-slate-200 rounded-2xl p-5 mb-4 variant-item">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
          <div class="lg:col-span-2">
            <label class="block text-sm font-medium text-slate-700 mb-1">Nama Varian</label>
            <input type="text" name="product[product_variants_attributes][NEW_RECORD][variant_name]"
                   class="<%= input_class %>" placeholder="1 pcs / 1 dus">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Satuan</label>
            <input type="text" name="product[product_variants_attributes][NEW_RECORD][unit]"
                   class="<%= input_class %>" placeholder="pcs">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Harga Grosir</label>
            <input type="number" name="product[product_variants_attributes][NEW_RECORD][price_grosir]"
                   class="<%= input_class %>" step="100">
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Harga Ecer</label>
            <input type="number" name="product[product_variants_attributes][NEW_RECORD][price_ecer]"
                   class="<%= input_class %>" step="100">
          </div>
        </div>
        <div class="mt-4 flex items-end justify-between">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Stok Minimum</label>
            <input type="number" name="product[product_variants_attributes][NEW_RECORD][stock_minimum]"
                   value="10" class="w-40 px-4 py-3 border border-slate-200 rounded-2xl bg-slate-50 focus:bg-white focus:ring-2 focus:ring-sky-500">
          </div>
          <button type="button" data-action="click->add-variant#remove"
                  class="text-red-600 hover:text-red-700 text-sm font-medium hover:bg-red-50 px-3 py-1.5 rounded-xl transition">
            Hapus Varian
          </button>
        </div>
      </div>
    </template>

    <div data-add-variant-target="container">
      <%= f.fields_for :product_variants do |variant_form| %>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 mb-4 variant-item">
          <%= variant_form.hidden_field :id %>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <div class="lg:col-span-2">
              <%= variant_form.label :variant_name, "Nama Varian", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= variant_form.text_field :variant_name, class: input_class %>
            </div>
            <div>
              <%= variant_form.label :unit, "Satuan", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= variant_form.text_field :unit, class: input_class %>
            </div>
            <div>
              <%= variant_form.label :price_grosir, "Harga Grosir", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= variant_form.number_field :price_grosir, class: input_class, step: 100 %>
            </div>
            <div>
              <%= variant_form.label :price_ecer, "Harga Ecer", class: "block text-sm font-medium text-slate-700 mb-1" %>
              <%= variant_form.number_field :price_ecer, class: input_class, step: 100 %>
            </div>
          </div>

          <div class="mt-4 flex items-end justify-between gap-4">
            <div class="flex flex-wrap items-end gap-6">
              <div>
                <%= variant_form.label :stock_minimum, "Stok Minimum", class: "block text-sm font-medium text-slate-700 mb-1" %>
                <%= variant_form.number_field :stock_minimum, class: "w-40 px-4 py-3 border border-slate-200 rounded-2xl bg-slate-50 focus:bg-white focus:ring-2 focus:ring-sky-500" %>
              </div>
              <% if variant_form.object.persisted? && defined?(@stock_totals) %>
                <% snapshot = StockInventory.variant_snapshot(variant_form.object, totals: @stock_totals) %>
                <div>
                  <p class="block text-sm font-medium text-slate-700 mb-1">Stok Saat Ini</p>
                  <div class="flex items-center gap-2 px-4 py-3 bg-white border border-slate-200 rounded-2xl">
                    <span class="text-sm font-semibold text-slate-900"><%= stock_quantity_label(snapshot[:on_hand], variant_form.object.unit) %></span>
                    <%= render "shared/stock_status_badge", status: snapshot[:status], compact: true %>
                  </div>
                </div>
              <% end %>
            </div>
            <div>
              <% if variant_form.object.persisted? %>
                <%= variant_form.hidden_field :_destroy, value: false, data: { add_variant_target: "destroyField" } %>
              <% end %>
              <button type="button" data-action="click->add-variant#remove"
                      class="text-red-600 hover:text-red-700 text-sm font-medium hover:bg-red-50 px-3 py-1.5 rounded-xl transition">
                Hapus Varian
              </button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <%= f.submit "Simpan Produk", class: "px-8 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition cursor-pointer shadow-sm" %>
    <%= link_to "Batal", admin_products_path, class: "px-8 py-3 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition" %>
  </div>

<% end %>
