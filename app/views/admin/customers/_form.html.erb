<% input_class = "form-control w-full px-4 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition" %>
<% select_class = "form-select-native w-full" %>
<% label_class = "block text-sm font-medium text-slate-700 mb-2" %>

<%= form_with(model: [:admin, customer], class: "space-y-6") do |f| %>

  <% if customer.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl text-sm">
      <p class="font-semibold mb-2"><%= pluralize(customer.errors.count, "kesalahan") %> perlu diperbaiki:</p>
      <ul class="list-disc list-inside space-y-1">
        <% customer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field min-w-0">
    <%= f.label :name, "Nama Pelanggan", class: label_class %>
    <%= f.text_field :name,
                     class: input_class,
                     placeholder: "Contoh: Warung Bu Siti" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="form-field min-w-0">
      <%= f.label :customer_type, "Tipe Pelanggan", class: label_class %>
      <%= f.select :customer_type,
                   [["Business / Grosir", "business"], ["Retail / Ecer", "retail"]],
                   {},
                   class: select_class,
                   data: { tom_select_search: "false" } %>
    </div>
    <div class="form-field min-w-0">
      <%= f.label :phone, "Telepon", class: label_class %>
      <%= f.text_field :phone,
                       class: input_class,
                       placeholder: "Contoh: 0812-3456-7890" %>
    </div>
  </div>

  <div class="form-field min-w-0">
    <%= f.label :address, "Alamat", class: label_class %>
    <%= f.text_area :address,
                    rows: 4,
                    class: "#{input_class} py-3",
                    placeholder: "Alamat lengkap pelanggan..." %>
  </div>

  <div class="form-field min-w-0">
    <%= f.label :balance, "Saldo / Piutang (Rp)", class: label_class %>
    <%= f.number_field :balance,
                       step: "0.01",
                       min: 0,
                       class: input_class,
                       placeholder: "0" %>
    <p class="text-xs text-slate-400 mt-1.5">Opsional — untuk pelanggan dengan catatan piutang.</p>
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <%= f.submit "Simpan Pelanggan",
                 class: "px-8 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition cursor-pointer shadow-sm" %>
    <%= link_to "Batal", admin_customers_path,
                class: "px-8 py-3 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition" %>
  </div>

<% end %>
