<% content_for :page_title, "Detail Pelanggan" %>
<% content_for :page_subtitle, @customer.name %>

<div class="p-6 lg:p-8 max-w-3xl space-y-6">
  <%= link_to admin_customers_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 transition" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Kembali ke daftar pelanggan
  <% end %>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white p-6">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4 min-w-0">
          <div class="w-14 h-14 bg-white/20 rounded-2xl flex items-center justify-center text-2xl flex-shrink-0">👤</div>
          <div class="min-w-0">
            <h2 class="text-xl font-bold truncate"><%= @customer.name %></h2>
            <% if @customer.business? %>
              <span class="inline-flex mt-2 px-2.5 py-1 rounded-full text-xs font-medium bg-white/20">Business / Grosir</span>
            <% else %>
              <span class="inline-flex mt-2 px-2.5 py-1 rounded-full text-xs font-medium bg-white/20">Retail / Ecer</span>
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <%= link_to edit_admin_customer_path(@customer),
                      class: "inline-flex items-center gap-1.5 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl text-xs font-medium transition" do %>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
            </svg>
            Edit
          <% end %>
        </div>
      </div>
    </div>

    <div class="p-6 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 bg-slate-50 rounded-2xl">
          <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Telepon</p>
          <% if @customer.phone.present? %>
            <a href="tel:<%= @customer.phone %>" class="font-medium text-sky-600 hover:underline"><%= @customer.phone %></a>
          <% else %>
            <p class="text-slate-400">—</p>
          <% end %>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl">
          <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Saldo / Piutang</p>
          <p class="font-semibold text-slate-900">
            Rp <%= number_with_delimiter(@customer.balance.to_i) %>
          </p>
        </div>
      </div>

      <div class="p-4 bg-slate-50 rounded-2xl">
        <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Alamat</p>
        <p class="text-slate-700"><%= @customer.address.presence || "—" %></p>
      </div>

      <% if @customer.user.present? %>
        <div class="p-4 bg-sky-50 border border-sky-100 rounded-2xl">
          <p class="text-xs text-sky-500 uppercase tracking-wider mb-1">Akun Online</p>
          <p class="font-medium text-slate-900"><%= @customer.user.email %></p>
          <p class="text-xs text-slate-500 mt-1">Terhubung ke akun pelanggan yang mendaftar sendiri.</p>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div class="p-4 border border-slate-100 rounded-2xl text-center">
          <p class="text-2xl font-bold text-slate-900"><%= @customer.orders.size %></p>
          <p class="text-xs text-slate-500 mt-1">Total Order</p>
        </div>
        <div class="p-4 border border-slate-100 rounded-2xl text-center">
          <p class="text-2xl font-bold text-slate-900"><%= @customer.pos_transactions.size %></p>
          <p class="text-xs text-slate-500 mt-1">Transaksi POS</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 text-sm text-slate-500 pt-2 border-t border-slate-100">
        <div>
          <p class="text-xs text-slate-400">Terdaftar</p>
          <p><%= @customer.created_at.strftime("%d/%m/%Y %H:%M") %></p>
        </div>
        <div class="text-right">
          <p class="text-xs text-slate-400">Terakhir diupdate</p>
          <p><%= @customer.updated_at.strftime("%d/%m/%Y %H:%M") %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= link_to edit_admin_customer_path(@customer),
                class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition text-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
      </svg>
      Edit Pelanggan
    <% end %>
    <%= link_to admin_customer_path(@customer),
                data: { turbo_method: :delete, turbo_confirm: "Yakin hapus pelanggan ini?" },
                class: "inline-flex items-center gap-2 px-6 py-3 border border-red-200 text-red-600 font-medium rounded-2xl hover:bg-red-50 transition text-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
      </svg>
      Hapus
    <% end %>
  </div>
</div>
