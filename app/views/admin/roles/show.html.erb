<% content_for :page_title, "Detail Role" %>
<% content_for :page_subtitle, @role.display_name %>

<div class="p-6 lg:p-8 space-y-6">
  <%= link_to admin_roles_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 transition" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
    Kembali ke daftar role
  <% end %>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="bg-gradient-to-br from-indigo-600 to-violet-700 text-white p-6">
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-xl font-bold"><%= @role.display_name %></h2>
          <p class="text-indigo-100 text-sm mt-1 font-mono"><%= @role.name %></p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-white/20"><%= role_scope_label(@role) %></span>
            <% if @role.system? %>
              <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-white/20">Role Sistem</span>
            <% end %>
          </div>
        </div>
        <%= link_to edit_admin_role_path(@role),
                    class: "inline-flex items-center gap-1.5 px-3 py-2 bg-white/20 hover:bg-white/30 rounded-xl text-xs font-medium transition flex-shrink-0" do %>
          Edit
        <% end %>
      </div>
    </div>

    <div class="p-6">
      <p class="text-sm text-slate-600"><%= role_description(@role) %></p>
      <div class="grid grid-cols-2 gap-4 mt-6">
        <div class="p-4 bg-slate-50 rounded-2xl">
          <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Total Pengguna</p>
          <p class="text-2xl font-bold text-slate-900"><%= @users.total_count %></p>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl">
          <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Dibuat</p>
          <p class="font-medium text-slate-900"><%= @role.created_at.strftime("%d/%m/%Y %H:%M") %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-100">
      <h3 class="font-semibold text-slate-900 text-sm">Pengguna dengan role ini</h3>
    </div>

    <% if @users.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Email</th>
              <th class="px-6 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Login Terakhir</th>
              <th class="px-6 py-3 text-center text-xs font-semibold text-slate-500 uppercase">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @users.each do |user| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-3 font-medium text-slate-900"><%= user.email %></td>
                <td class="px-6 py-3 text-slate-500 text-xs">
                  <%= user.last_sign_in_at ? user.last_sign_in_at.strftime("%d/%m/%Y %H:%M") : "—" %>
                </td>
                <td class="px-6 py-3 text-center">
                  <%= link_to "Lihat", admin_user_path(user), class: "text-sky-600 hover:underline text-xs font-medium" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @users %>
    <% else %>
      <div class="text-center py-12 px-6 text-slate-500 text-sm">
        Belum ada pengguna dengan role ini.
      </div>
    <% end %>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= link_to edit_admin_role_path(@role),
                class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition text-sm" do %>
      Edit Role
    <% end %>
    <% unless @role.system? %>
      <%= link_to admin_role_path(@role),
                  data: { turbo_method: :delete, turbo_confirm: "Yakin hapus role #{@role.display_name}?" },
                  class: "inline-flex items-center gap-2 px-6 py-3 border border-red-200 text-red-600 font-medium rounded-2xl hover:bg-red-50 transition text-sm" do %>
        Hapus Role
      <% end %>
    <% end %>
  </div>
</div>
