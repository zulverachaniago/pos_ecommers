<% content_for :page_title, "Master Role" %>
<% content_for :page_subtitle, "Kelola role dan hak akses pengguna" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div class="flex items-center gap-4">
      <div class="w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center">
        <svg class="w-6 h-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <div>
        <p class="text-2xl font-bold text-slate-900"><%= @roles.total_count %></p>
        <p class="text-sm text-slate-500">Total role global</p>
      </div>
    </div>
    <%= link_to new_admin_role_path,
                class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-sky-600 hover:bg-sky-700 text-white font-semibold rounded-2xl transition shadow-lg shadow-sky-600/20 text-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
      </svg>
      Tambah Role
    <% end %>
  </div>

  <% if @roles.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Role</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Nama Sistem</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Deskripsi</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Pengguna</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @roles.each do |role| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-indigo-100 to-violet-100 rounded-xl flex items-center justify-center flex-shrink-0">
                      <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                      </svg>
                    </div>
                    <%= link_to role.display_name, admin_role_path(role),
                                class: "font-semibold text-slate-900 hover:text-sky-600 transition" %>
                    <% if role.system? %>
                      <span class="text-[10px] font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">Sistem</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <%= render "admin/users/role_badge", role_name: role.name %>
                </td>
                <td class="px-6 py-4 text-slate-500 max-w-xs truncate"><%= role_description(role) %></td>
                <td class="px-6 py-4 text-right font-semibold text-slate-900">
                  <%= @user_counts[role.id] || 0 %>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center justify-center gap-2">
                    <%= link_to admin_role_path(role),
                                class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-slate-600 hover:bg-slate-50 rounded-xl text-xs font-medium transition" do %>
                      Detail
                    <% end %>
                    <%= link_to edit_admin_role_path(role),
                                class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sky-600 hover:bg-sky-50 rounded-xl text-xs font-medium transition" do %>
                      Edit
                    <% end %>
                    <% unless role.system? %>
                      <%= link_to admin_role_path(role),
                                  data: { turbo_method: :delete, turbo_confirm: "Yakin hapus role #{role.display_name}?" },
                                  class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-red-600 hover:bg-red-50 rounded-xl text-xs font-medium transition" do %>
                        Hapus
                      <% end %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "shared/pagination", collection: @roles %>
    </div>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-20 px-6">
      <div class="w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center text-3xl mx-auto mb-4">🛡️</div>
      <h3 class="text-lg font-semibold text-slate-900 mb-2">Belum ada role</h3>
      <p class="text-slate-500 text-sm mb-6">Tambahkan role untuk mengatur hak akses pengguna.</p>
      <%= link_to "Tambah Role Pertama", new_admin_role_path,
                  class: "inline-flex items-center gap-2 px-6 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition text-sm" %>
    </div>
  <% end %>
</div>
