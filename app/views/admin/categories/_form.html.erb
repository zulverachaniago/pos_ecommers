<%= form_with(model: [:admin, category], class: "space-y-6") do |f| %>

  <% if category.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl text-sm">
      <p class="font-semibold mb-2"><%= pluralize(category.errors.count, "kesalahan") %> perlu diperbaiki:</p>
      <ul class="list-disc list-inside space-y-1">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nama Kategori", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.text_field :name,
                     class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                     placeholder: "Contoh: Mie Instan, Minuman, Sabun Cuci" %>
  </div>

  <div>
    <%= f.label :description, "Deskripsi", class: "block text-sm font-medium text-slate-700 mb-2" %>
    <%= f.text_area :description,
                    rows: 4,
                    class: "w-full px-4 py-3 border border-slate-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 bg-slate-50 focus:bg-white transition",
                    placeholder: "Deskripsi singkat kategori ini..." %>
  </div>

  <div class="flex flex-wrap gap-3 pt-2">
    <%= f.submit "Simpan Kategori",
                 class: "px-8 py-3 bg-sky-600 text-white font-semibold rounded-2xl hover:bg-sky-700 transition cursor-pointer shadow-sm" %>
    <%= link_to "Batal", admin_categories_path,
                class: "px-8 py-3 border border-slate-200 text-slate-600 font-medium rounded-2xl hover:bg-slate-50 transition" %>
  </div>

<% end %>
