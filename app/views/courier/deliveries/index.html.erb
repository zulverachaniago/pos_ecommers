<% content_for :page_title, "Kirim Pesanan" %>
<% content_for :page_subtitle, "Pesanan siap dikirim (status Proses)" %>

<div class="p-6 lg:p-8 space-y-6">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 bg-sky-100 rounded-2xl flex items-center justify-center text-2xl">📦</div>
    <div>
      <p class="text-2xl font-bold text-slate-900"><%= @ready_count %></p>
      <p class="text-sm text-slate-500">Pesanan menunggu pengiriman</p>
    </div>
  </div>

  <%= render "courier/shared/order_search",
             search_path: courier_deliveries_path,
             placeholder: "Masukkan nomor order..." %>

  <% if @orders.any? %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-100">
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">No. Order</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Customer</th>
              <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase">Alamat</th>
              <th class="px-6 py-4 text-right text-xs font-semibold text-slate-500 uppercase">Total</th>
              <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% @orders.each do |order| %>
              <tr class="hover:bg-slate-50/80 transition">
                <td class="px-6 py-4 font-mono text-xs font-semibold text-slate-900"><%= order.order_number %></td>
                <td class="px-6 py-4">
                  <p class="font-medium text-slate-900"><%= order.customer.name %></p>
                  <p class="text-xs text-slate-500"><%= order.customer.phone.presence || "—" %></p>
                </td>
                <td class="px-6 py-4 text-slate-600 text-xs max-w-[200px] truncate"><%= order.customer.address.presence || "—" %></td>
                <td class="px-6 py-4 text-right font-semibold text-emerald-600">Rp <%= number_with_delimiter(order.total_amount.to_i) %></td>
                <td class="px-6 py-4 text-center">
                  <%= link_to "Detail", courier_delivery_path(order),
                              class: "inline-flex px-4 py-2 text-xs font-semibold text-sky-700 bg-sky-50 hover:bg-sky-100 rounded-xl transition" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <%= paginate @orders if respond_to?(:paginate) %>
  <% else %>
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm text-center py-16 px-6">
      <div class="text-4xl mb-3">✅</div>
      <p class="text-slate-500 text-sm">
        <% if params[:q].present? %>
          Pesanan "<%= params[:q] %>" tidak ditemukan atau belum siap dikirim.
        <% else %>
          Tidak ada pesanan dengan status Proses.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
