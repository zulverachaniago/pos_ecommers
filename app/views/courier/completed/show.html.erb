<% content_for :page_title, @order.order_number %>
<% content_for :page_subtitle, "Detail pengiriman" %>

<% customer = @order.customer %>

<div class="p-6 lg:p-8 space-y-6 max-w-3xl">
  <%= link_to courier_completed_index_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-500 hover:text-sky-600 transition" do %>
    ← Kembali ke daftar selesai
  <% end %>

  <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 space-y-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p class="text-xs text-slate-500 uppercase tracking-wider mb-1">Nomor Pesanan</p>
        <h1 class="text-xl font-bold font-mono text-slate-900"><%= @order.order_number %></h1>
      </div>
      <%= render "store/orders/status_badge", order: @order %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
      <div>
        <p class="text-xs text-slate-400 mb-1">Customer</p>
        <p class="font-semibold text-slate-900"><%= customer.name %></p>
        <p class="text-sm text-slate-600 mt-1"><%= customer.phone.presence || "—" %></p>
      </div>
      <div>
        <p class="text-xs text-slate-400 mb-1">Total</p>
        <p class="text-lg font-bold text-emerald-600">Rp <%= number_with_delimiter(@order.total_amount.to_i) %></p>
        <%= render "store/orders/payment_badge", order: @order %>
      </div>
    </div>

    <div class="pt-4 border-t border-slate-100">
      <p class="text-xs text-slate-400 mb-1">Alamat Pengiriman</p>
      <p class="text-sm text-slate-700 leading-relaxed"><%= customer.address.presence || "—" %></p>
    </div>

    <% if @order.order_status_ship? && @order.courier_id == current_user.id %>
      <%= form_with url: finish_courier_completed_path(@order), method: :patch, class: "pt-4 border-t border-slate-100 space-y-4" do %>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-2">Catatan (opsional)</label>
          <textarea name="order[notes]" rows="2" placeholder="Contoh: Diterima customer"
                    class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500"></textarea>
        </div>
        <button type="submit" class="courier-action-btn w-full">Tandai Selesai</button>
      <% end %>
    <% elsif @order.order_status_done? %>
      <div class="pt-4 border-t border-slate-100 bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-sm text-emerald-800">
        Pesanan ini sudah selesai dikirim.
      </div>
    <% end %>
  </div>
</div>
