<div class="min-h-screen flex">
  <!-- Brand panel -->
  <div class="hidden lg:flex lg:w-1/2 bg-gradient-to-br from-slate-900 via-sky-900 to-sky-800 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-400 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-80 h-80 bg-sky-600 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 flex flex-col justify-between p-12 w-full">
      <%= link_to root_path, class: "flex items-center gap-3 group w-fit" do %>
        <div class="w-12 h-12 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center text-2xl shadow-lg group-hover:bg-white/20 transition">
          🛒
        </div>
        <div>
          <p class="text-xl font-bold tracking-tight">Oder Store</p>
          <p class="text-xs text-sky-200">Agen Kelontong Modern</p>
        </div>
      <% end %>

      <div class="max-w-md">
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full text-sm mb-8">
          <span class="text-base">✨</span>
          Gratis, tanpa biaya pendaftaran
        </div>

        <h1 class="text-4xl xl:text-5xl font-bold leading-tight tracking-tight mb-6">
          Daftarkan warung Anda<br>dalam hitungan menit
        </h1>
        <p class="text-lg text-sky-100 leading-relaxed">
          Bergabung dengan ratusan warung di Klapanunggal yang sudah order grosir lebih mudah dan untung.
        </p>

        <ul class="mt-10 space-y-4">
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-xl flex items-center justify-center text-sm">📱</span>
            <div>
              <p class="font-semibold">Order kapan saja</p>
              <p class="text-sm text-sky-200 mt-0.5">Lihat stok & harga real-time lewat HP</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-xl flex items-center justify-center text-sm">💰</span>
            <div>
              <p class="font-semibold">Harga grosir kompetitif</p>
              <p class="text-sm text-sky-200 mt-0.5">Lebih murah dari pasar tradisional</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex-shrink-0 w-8 h-8 bg-white/10 rounded-xl flex items-center justify-center text-sm">🚛</span>
            <div>
              <p class="font-semibold">Pengantaran cepat</p>
              <p class="text-sm text-sky-200 mt-0.5">Antar langsung ke warung Anda</p>
            </div>
          </li>
        </ul>
      </div>

      <p class="text-sm text-sky-300/80">&copy; <%= Date.current.year %> Oder Store. Klapanunggal, Bogor.</p>
    </div>
  </div>

  <!-- Form panel -->
  <div class="flex-1 flex items-center justify-center bg-gray-50 px-6 py-12">
    <div class="w-full max-w-md">
      <!-- Mobile header -->
      <div class="lg:hidden text-center mb-8">
        <%= link_to root_path, class: "inline-flex items-center gap-3 mb-6" do %>
          <div class="w-11 h-11 bg-gradient-to-br from-sky-600 to-blue-700 rounded-2xl flex items-center justify-center text-2xl shadow-lg">
            🛒
          </div>
          <div class="text-left">
            <p class="text-lg font-bold text-gray-900">Oder Store</p>
            <p class="text-xs text-gray-500">Agen Kelontong Modern</p>
          </div>
        <% end %>
        <h2 class="text-2xl font-bold text-gray-900">Daftar akun warung</h2>
        <p class="text-gray-500 mt-1">Buat akun gratis untuk mulai order grosir</p>
      </div>

      <div class="hidden lg:block mb-8">
        <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Daftar akun warung</h2>
        <p class="text-gray-500 mt-2">Buat akun gratis — cukup email & password</p>
      </div>

      <% if resource.errors.any? %>
        <div class="mb-6 bg-red-50 border border-red-200 text-red-700 px-5 py-4 rounded-2xl">
          <div class="flex items-start gap-3">
            <span class="text-lg leading-none mt-0.5">⚠️</span>
            <div>
              <p class="text-sm font-semibold mb-2">
                <%= pluralize(resource.errors.count, "kesalahan") %> mencegah pendaftaran:
              </p>
              <ul class="text-sm space-y-1 list-disc list-inside">
                <% resource.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>

      <div class="bg-white shadow-xl shadow-gray-200/60 border border-gray-100 rounded-3xl p-8">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>

          <div>
            <%= f.label :email, "Alamat Email", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </span>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                                  placeholder: "nama@warung.com",
                                  class: "w-full pl-12 pr-4 py-3.5 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent bg-gray-50 focus:bg-white transition" %>
            </div>
          </div>

          <div>
            <%= f.label :password, "Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </span>
              <%= f.password_field :password, autocomplete: "new-password",
                                     placeholder: "Minimal 6 karakter",
                                     class: "w-full pl-12 pr-4 py-3.5 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent bg-gray-50 focus:bg-white transition" %>
            </div>
            <p class="text-xs text-gray-400 mt-2 ml-1">Gunakan kombinasi huruf & angka untuk keamanan lebih baik</p>
          </div>

          <div>
            <%= f.label :password_confirmation, "Konfirmasi Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400 pointer-events-none">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <%= f.password_field :password_confirmation, autocomplete: "new-password",
                                     placeholder: "Ulangi password",
                                     class: "w-full pl-12 pr-4 py-3.5 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent bg-gray-50 focus:bg-white transition" %>
            </div>
          </div>

          <%= f.submit "Daftar Sekarang — Gratis",
                       class: "w-full py-4 bg-sky-600 hover:bg-sky-700 active:bg-sky-800 text-white font-semibold rounded-2xl transition shadow-lg shadow-sky-600/25 cursor-pointer mt-2" %>
        <% end %>
      </div>

      <p class="text-xs text-gray-400 text-center mt-4 px-4">
        Dengan mendaftar, Anda setuju menggunakan layanan Oder Store untuk keperluan bisnis warung.
      </p>

      <div class="mt-6 text-center">
        <p class="text-sm text-gray-500">
          Sudah punya akun?
          <%= link_to "Masuk di sini", new_session_path(resource_name),
                      class: "text-sky-600 font-semibold hover:text-sky-700 hover:underline ml-1" %>
        </p>
        <%= link_to "← Kembali ke beranda", root_path,
                    class: "inline-block mt-4 text-sm text-gray-400 hover:text-gray-600 transition" %>
      </div>
    </div>
  </div>
</div>
