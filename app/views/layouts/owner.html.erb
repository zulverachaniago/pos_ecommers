<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Owner — Oder Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Oder Store Owner">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "shared/pwa_head" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% user_initial = current_user.email.to_s.first&.upcase || "O" %>

  <body class="bg-slate-100 antialiased" data-controller="sidebar tom-select">
    <div data-sidebar-target="overlay"
         data-action="click->sidebar#close"
         class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 lg:hidden"></div>

    <div class="flex h-screen overflow-hidden">
      <aside data-sidebar-target="sidebar"
             class="fixed lg:static inset-y-0 left-0 z-50 w-72 flex flex-col bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none">

        <div class="p-6 border-b border-white/10">
          <%= link_to owner_root_path, class: "flex items-center gap-3 group" do %>
            <div class="w-11 h-11 bg-gradient-to-br from-violet-500 to-purple-600 rounded-2xl flex items-center justify-center text-xl shadow-lg shadow-violet-900/50 group-hover:scale-105 transition">
              📊
            </div>
            <div>
              <p class="text-lg font-bold tracking-tight">Oder Store</p>
              <p class="text-xs text-violet-300/80">Owner Panel</p>
            </div>
          <% end %>
        </div>

        <nav class="flex-1 overflow-y-auto p-4 space-y-6">
          <div>
            <p class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-widest">Menu Utama</p>
            <div class="space-y-1">
              <%= owner_nav_link owner_root_path, exact: true do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 5.25v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
                Dashboard Penjualan
              <% end %>

              <%= owner_nav_link owner_reports_sales_path, prefix: "/owner/reports/sales" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                </svg>
                Report Penjualan
              <% end %>

              <%= owner_nav_link owner_reports_stock_path, prefix: "/owner/reports/stock" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                </svg>
                Report Stok
              <% end %>
            </div>
          </div>

          <div>
            <p class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-widest">Data Master</p>
            <div class="space-y-1">
              <%= owner_nav_link owner_customers_path, prefix: "/owner/customers" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
                </svg>
                Customer
              <% end %>

              <%= owner_nav_link owner_suppliers_path, prefix: "/owner/suppliers" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                </svg>
                Supplier
              <% end %>
            </div>
          </div>
        </nav>

        <div class="p-4 border-t border-white/10">
          <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center text-sm font-bold shadow-lg">
                <%= user_initial %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold truncate"><%= current_user.email %></p>
                <p class="text-xs text-slate-400">Owner</p>
              </div>
            </div>
            <%= link_to staff_logout_path,
                        data: { turbo_method: :delete, turbo_confirm: "Yakin keluar?" },
                        class: "mt-3 flex items-center justify-center gap-2 w-full py-2 text-sm font-medium text-red-300 hover:text-red-200 hover:bg-red-500/10 rounded-xl transition" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
              Keluar
            <% end %>
          </div>
        </div>
      </aside>

      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <header class="flex-shrink-0 bg-white/80 backdrop-blur-md border-b border-slate-200/80 px-4 lg:px-8 py-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <button type="button"
                    data-action="click->sidebar#toggle"
                    class="lg:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
            <div>
              <% if content_for?(:page_title) %>
                <h1 class="text-lg font-bold text-slate-900"><%= yield :page_title %></h1>
              <% else %>
                <h1 class="text-lg font-bold text-slate-900">Oder Store Owner</h1>
              <% end %>
              <% if content_for?(:page_subtitle) %>
                <p class="text-xs text-slate-500 hidden sm:block"><%= yield :page_subtitle %></p>
              <% end %>
            </div>
          </div>

          <div class="w-9 h-9 bg-gradient-to-br from-violet-500 to-purple-600 rounded-xl flex items-center justify-center text-xs font-bold text-white shadow-md lg:hidden">
            <%= user_initial %>
          </div>
        </header>

        <%= render "shared/flash" %>

        <main class="flex-1 overflow-auto">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
