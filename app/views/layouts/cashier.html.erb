<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kasir — Oder Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Oder Store Kasir">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "shared/pwa_head" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% user_initial = current_user.email.to_s.first&.upcase || "K" %>

  <body class="bg-slate-100 antialiased" data-controller="sidebar tom-select">
    <!-- Mobile overlay -->
    <div data-sidebar-target="overlay"
         data-action="click->sidebar#close"
         class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 lg:hidden"></div>

    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside data-sidebar-target="sidebar"
             class="fixed lg:static inset-y-0 left-0 z-50 w-72 flex flex-col bg-gradient-to-b from-slate-900 via-slate-900 to-slate-800 text-white transform -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl lg:shadow-none">

        <!-- Logo -->
        <div class="p-6 border-b border-white/10">
          <%= link_to pos_root_path, class: "flex items-center gap-3 group" do %>
            <div class="w-11 h-11 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-2xl flex items-center justify-center text-xl shadow-lg shadow-emerald-900/50 group-hover:scale-105 transition">
              🛒
            </div>
            <div>
              <p class="text-lg font-bold tracking-tight">Oder Store</p>
              <p class="text-xs text-emerald-300/80">Mode Kasir</p>
            </div>
          <% end %>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto p-4 space-y-6">
          <div>
            <p class="px-3 mb-2 text-[10px] font-semibold text-slate-500 uppercase tracking-widest">Menu Utama</p>
            <div class="space-y-1">
              <%= cashier_nav_link pos_root_path, exact: true do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 5.25v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                </svg>
                Dashboard Penjualan
              <% end %>

              <%= cashier_nav_link new_pos_transaction_path, exact: true do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                </svg>
                POS
              <% end %>

              <%= cashier_nav_link pos_transactions_path,
                                   match: %r{\A/pos/transactions(?:/\d+)?\z} do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
                </svg>
                List Transaksi
              <% end %>

              <%= cashier_nav_link pos_orders_path, prefix: "/pos/orders" do %>
                <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
                </svg>
                Pesanan Customer
                <% pending = Order.where.not(order_status: :done).count %>
                <% if pending > 0 %>
                  <span class="ml-auto inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 text-[10px] font-bold bg-amber-400 text-slate-900 rounded-full"><%= pending %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </nav>

        <!-- User card -->
        <div class="p-4 border-t border-white/10">
          <div class="bg-white/5 backdrop-blur-sm rounded-2xl p-4">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center text-sm font-bold shadow-lg">
                <%= user_initial %>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold truncate"><%= current_user.email %></p>
                <p class="text-xs text-slate-400">Kasir</p>
              </div>
            </div>
            <%= link_to staff_logout_path,
                        data: { turbo_method: :delete, turbo_confirm: "Yakin keluar dari kasir?" },
                        class: "mt-3 flex items-center justify-center gap-2 w-full py-2 text-sm font-medium text-red-300 hover:text-red-200 hover:bg-red-500/10 rounded-xl transition" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
              Keluar
            <% end %>
          </div>
        </div>
      </aside>

      <!-- Main area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- Top bar -->
        <header class="flex-shrink-0 bg-white/80 backdrop-blur-md border-b border-slate-200/80 px-4 lg:px-8 py-4 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <button type="button"
                    data-action="click->sidebar#toggle"
                    class="lg:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 transition">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
            <div>
              <% if content_for?(:page_title) %>
                <h1 class="text-lg font-bold text-slate-900"><%= yield :page_title %></h1>
              <% else %>
                <h1 class="text-lg font-bold text-slate-900">Oder Store Kasir</h1>
              <% end %>
              <% if content_for?(:page_subtitle) %>
                <p class="text-xs text-slate-500 hidden sm:block"><%= yield :page_subtitle %></p>
              <% end %>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <%= link_to new_pos_transaction_path,
                        class: "hidden sm:flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl transition shadow-md shadow-emerald-600/20" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              Transaksi Baru
            <% end %>
            <div class="w-9 h-9 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl flex items-center justify-center text-xs font-bold text-white shadow-md lg:hidden">
              <%= user_initial %>
            </div>
          </div>
        </header>

        <%= render "shared/flash" %>

        <main class="flex-1 <%= content_for?(:pos_full_height) ? 'min-h-0 flex flex-col overflow-hidden' : 'overflow-auto' %>">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
