<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Toko Online" %> · Oder Store</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%= render "shared/pwa_head" %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50 antialiased flex flex-col" data-controller="tom-select">
    <header class="bg-white/90 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex items-center justify-between h-16 gap-4">
          <%= link_to store_products_path, class: "flex items-center gap-2.5 group flex-shrink-0 min-w-0" do %>
            <div class="w-10 h-10 bg-gradient-to-br from-sky-600 to-blue-700 rounded-2xl flex items-center justify-center text-lg shadow-md group-hover:scale-105 transition flex-shrink-0">
              🛒
            </div>
            <div class="hidden sm:block min-w-0">
              <p class="text-base font-bold tracking-tight text-gray-900 leading-tight truncate">Oder Store</p>
              <p class="text-[11px] text-gray-500 -mt-0.5 truncate">Toko Online Grosir</p>
            </div>
          <% end %>

          <%= render "store/shared/header_nav" %>
        </div>
      </div>
    </header>

    <%= render "shared/flash", wrapper_class: "max-w-7xl mx-auto px-4 sm:px-6 pt-4 space-y-2" %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <footer class="border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 text-center text-sm text-gray-500">
        <p>&copy; <%= Date.current.year %> Oder Store · Klapanunggal, Bogor</p>
      </div>
    </footer>
  </body>
</html>
